2026-09-24T00:30:46.0505821Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:46.0506020Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:46.0506436Z     # required to build '-native' target
2026-09-24T00:30:46.0506665Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:46.0506869Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:46.0507135Z   ccache-recipe-contol: |
2026-09-24T00:30:46.0507330Z     # disable all recipes
2026-09-24T00:30:46.0507510Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:46.0507698Z     # table with enabled recipes
2026-09-24T00:30:46.0507934Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:46.0508175Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:46.0508416Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:46.0508656Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:46.0508878Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:46.0509114Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:46.0509326Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:46.0509529Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:46.0509743Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:46.0509957Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:46.0510269Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:46.0510501Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:46.0510709Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:46.0510915Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:46.0511118Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:46.0511353Z   ci: |
2026-09-24T00:30:46.0511650Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:46.0511878Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:46.0512204Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:46.0512521Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:46.0512717Z   parallelism: |
2026-09-24T00:30:46.0512967Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:46.0513231Z     #
2026-09-24T00:30:46.0513450Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:46.0513787Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:46.0514122Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:46.0514446Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:46.0514779Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:46.0515121Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:46.0515642Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:46.0515976Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:46.0516262Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:46.0516465Z     #
2026-09-24T00:30:46.0516699Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:46.0517046Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:46.0517399Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:46.0517744Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:46.0518144Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:46.0518542Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:46.0518781Z     #
2026-09-24T00:30:46.0519013Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:46.0519360Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:46.0519638Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:46.0519850Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:46.0520041Z     do_compile[number_threads] = "8"
2026-09-24T00:30:46.0520238Z   git-dl: |
2026-09-24T00:30:46.0520445Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:46.0520766Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:46.0521073Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:46.0521332Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:46.0521529Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:46.0521733Z   git-shallow-kernels: |
2026-09-24T00:30:46.0521977Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:46.0522320Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:46.0522667Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:46.0522958Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:46.0523173Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:46.0523397Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:46.0523628Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:46.0523847Z   base: |
2026-09-24T00:30:46.0523999Z     CONF_VERSION = "2"
2026-09-24T00:30:46.0524187Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:46.0524391Z     INHERIT += "buildhistory"
2026-09-24T00:30:46.0524575Z     INHERIT += "rm_work"
2026-09-24T00:30:46.0524760Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:46.0524948Z   diskmon: |
2026-09-24T00:30:46.0525110Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:46.0525419Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:46.0525730Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:46.0525940Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:30:46.0526148Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:30:46.0526345Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:30:46.0526548Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:30:46.0526741Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:30:46.0526942Z       HALT,/tmp,10M,1K"
2026-09-24T00:30:46.0527116Z   clo-mirrors: |
2026-09-24T00:30:46.0527295Z     MIRRORS:append = " \
2026-09-24T00:30:46.0527554Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T00:30:46.0527880Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T00:30:46.0528193Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T00:30:46.0528463Z     "
2026-09-24T00:30:46.0528609Z   cmdline: |
2026-09-24T00:30:46.0528822Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"

2026-09-24T15:51:59.3001960Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:51:59.3002270Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \

2026-09-24T15:51:59.2981424Z     # table with enabled recipes
2026-09-24T15:51:59.2981652Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:51:59.2981859Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:51:59.2982094Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:51:59.2982331Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:51:59.2982546Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:51:59.2982773Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:51:59.2982987Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:51:59.2983189Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:51:59.2983392Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:51:59.2983599Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:51:59.2983811Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:51:59.2984029Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:51:59.2984237Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:51:59.2984442Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:51:59.2984642Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:51:59.2985064Z   ci: |
2026-09-24T15:51:59.2985225Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:51:59.2985463Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:51:59.2985780Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:51:59.2986103Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:51:59.2986374Z   parallelism: |
2026-09-24T15:51:59.2986616Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:51:59.2986886Z     #
2026-09-24T15:51:59.2987225Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:51:59.2987654Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:51:59.2987998Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:51:59.2988333Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:51:59.2988691Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:51:59.2989046Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:51:59.2989389Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:51:59.2989725Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:51:59.2990031Z     # reach sstate, so re-running never helps.
2026-09-24T15:51:59.2990238Z     #
2026-09-24T15:51:59.2990468Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:51:59.2990817Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:51:59.2991175Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:51:59.2991524Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:51:59.2991987Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:51:59.2992314Z     # warm build, so neither setting costs anything there.
2026-09-24T15:51:59.2992544Z     #
2026-09-24T15:51:59.2992763Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:51:59.2993097Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:51:59.2993419Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:51:59.2993626Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:51:59.2993826Z     do_compile[number_threads] = "8"
2026-09-24T15:51:59.2994020Z   git-dl: |
2026-09-24T15:51:59.2994232Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:51:59.2994593Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:51:59.2994913Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:51:59.2995172Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:51:59.2995374Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:51:59.2995587Z   git-shallow-kernels: |
2026-09-24T15:51:59.2995838Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:51:59.2996175Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:51:59.2996513Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:51:59.2996801Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:51:59.2997018Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:51:59.2997381Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:51:59.2997689Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:51:59.2997919Z   base: |
2026-09-24T15:51:59.2998074Z     CONF_VERSION = "2"
2026-09-24T15:51:59.2998261Z     INHERIT += "buildstats-summary"
2026-09-24T15:51:59.2998477Z     INHERIT += "buildhistory"
2026-09-24T15:51:59.2998670Z     INHERIT += "rm_work"
2026-09-24T15:51:59.2998870Z     INHERIT += "image-buildinfo"
2026-09-24T15:51:59.2999064Z   diskmon: |
2026-09-24T15:51:59.2999232Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:51:59.2999510Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:51:59.2999722Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:51:59.2999924Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:51:59.3000127Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:51:59.3000432Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:51:59.3000628Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:51:59.3000826Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:51:59.3001021Z       HALT,/tmp,10M,1K"

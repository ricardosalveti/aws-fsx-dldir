2026-09-24T15:51:59.2979696Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:51:59.2979957Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:51:59.2980184Z     # required to build '-native' target
2026-09-24T15:51:59.2980400Z     HOSTTOOLS += "ccache"
2026-09-24T15:51:59.2980590Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:51:59.2980813Z   ccache-recipe-contol: |
2026-09-24T15:51:59.2981001Z     # disable all recipes

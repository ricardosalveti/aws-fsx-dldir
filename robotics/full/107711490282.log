2026-09-24T15:54:26.9042319Z header:
2026-09-24T15:54:26.9042487Z   version: 14
2026-09-24T15:54:26.9042650Z local_conf_header:
2026-09-24T15:54:26.9043050Z   mirror: |
2026-09-24T15:54:26.9043462Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T15:54:26.9043812Z   ccache: |
2026-09-24T15:54:26.9043964Z     INHERIT += "ccache"
2026-09-24T15:54:26.9044182Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:54:26.9044422Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:54:26.9044657Z     # required to build '-native' target
2026-09-24T15:54:26.9044859Z     HOSTTOOLS += "ccache"
2026-09-24T15:54:26.9045060Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:54:26.9045272Z   ccache-recipe-contol: |
2026-09-24T15:54:26.9045457Z     # disable all recipes
2026-09-24T15:54:26.9045629Z     CCACHE_DISABLE = "1"
2026-09-24T15:54:26.9045812Z     # table with enabled recipes
2026-09-24T15:54:26.9046027Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:54:26.9046240Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:54:26.9046488Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:54:26.9046735Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:54:26.9046983Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:54:26.9047214Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:54:26.9047435Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:54:26.9047630Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:54:26.9047831Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:54:26.9048041Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:54:26.9048254Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:54:26.9048467Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:54:26.9048669Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:54:26.9048868Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:54:26.9049060Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:54:26.9049245Z   ci: |
2026-09-24T15:54:26.9049401Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:54:26.9049878Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:54:26.9050213Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:54:26.9050588Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:54:26.9050796Z   parallelism: |
2026-09-24T15:54:26.9051038Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:54:26.9051307Z     #
2026-09-24T15:54:26.9051522Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:54:26.9051874Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:54:26.9052202Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:54:26.9052528Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:54:26.9053011Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:54:26.9053373Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:54:26.9053713Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:54:26.9054050Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:54:26.9054343Z     # reach sstate, so re-running never helps.
2026-09-24T15:54:26.9054556Z     #
2026-09-24T15:54:26.9054782Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:54:26.9055131Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:54:26.9055486Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:54:26.9055833Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:54:26.9056174Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:54:26.9056594Z     # warm build, so neither setting costs anything there.
2026-09-24T15:54:26.9056828Z     #
2026-09-24T15:54:26.9057050Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:54:26.9057389Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:54:26.9057662Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:54:26.9057872Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:54:26.9058072Z     do_compile[number_threads] = "8"
2026-09-24T15:54:26.9058260Z   git-dl: |
2026-09-24T15:54:26.9058471Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:54:26.9058789Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:54:26.9059115Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:54:26.9059375Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:54:26.9059565Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:54:26.9059763Z   git-shallow-kernels: |
2026-09-24T15:54:26.9060021Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:54:26.9060360Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:54:26.9060703Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:54:26.9060982Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:54:26.9061203Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:54:26.9061419Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:54:26.9061641Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:54:26.9061839Z   base: |
2026-09-24T15:54:26.9061992Z     CONF_VERSION = "2"
2026-09-24T15:54:26.9062171Z     INHERIT += "buildstats-summary"

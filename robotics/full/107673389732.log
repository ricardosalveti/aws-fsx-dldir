2026-09-24T00:30:47.8931436Z   version: 14
2026-09-24T00:30:47.8931620Z local_conf_header:
2026-09-24T00:30:47.8931817Z   mirror: |
2026-09-24T00:30:47.8932168Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:30:47.8932577Z   ccache: |
2026-09-24T00:30:47.8932764Z     INHERIT += "ccache"
2026-09-24T00:30:47.8933124Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:47.8933332Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:47.8933642Z     # required to build '-native' target
2026-09-24T00:30:47.8933870Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:47.8934057Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:47.8934263Z   ccache-recipe-contol: |
2026-09-24T00:30:47.8934615Z     # disable all recipes
2026-09-24T00:30:47.8934834Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:47.8935026Z     # table with enabled recipes
2026-09-24T00:30:47.8935232Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:47.8935434Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:47.8935672Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:47.8935912Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:47.8936120Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:47.8936345Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:47.8936556Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:47.8936760Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:47.8936960Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:47.8937166Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:47.8937378Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:47.8937600Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:47.8937829Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:47.8938079Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:47.8938518Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:47.8938717Z   ci: |
2026-09-24T00:30:47.8938875Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:47.8939095Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:47.8939414Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:47.8939723Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:47.8939916Z   parallelism: |
2026-09-24T00:30:47.8940145Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:47.8940404Z     #
2026-09-24T00:30:47.8940618Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:47.8940956Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:47.8941268Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:47.8941592Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:47.8941926Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:47.8942258Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:47.8942584Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:47.8942900Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:47.8943188Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:47.8943387Z     #
2026-09-24T00:30:47.8943604Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:47.8943937Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:47.8944279Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:47.8944747Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:47.8945192Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:47.8945503Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:47.8945737Z     #
2026-09-24T00:30:47.8945950Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:47.8946272Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:47.8946537Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:47.8946741Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:47.8946922Z     do_compile[number_threads] = "8"
2026-09-24T00:30:47.8947110Z   git-dl: |
2026-09-24T00:30:47.8947313Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:47.8947644Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:47.8947945Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:47.8948200Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:47.8948400Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:47.8948613Z   git-shallow-kernels: |
2026-09-24T00:30:47.8948856Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:47.8949180Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:47.8949510Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.

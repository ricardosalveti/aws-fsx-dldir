2026-09-24T00:30:46.5863078Z header:
2026-09-24T00:30:46.5863241Z   version: 14
2026-09-24T00:30:46.5863406Z local_conf_header:
2026-09-24T00:30:46.5863626Z   mirror: |
2026-09-24T00:30:46.5866466Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:30:46.5866883Z   ccache: |
2026-09-24T00:30:46.5867053Z     INHERIT += "ccache"
2026-09-24T00:30:46.5867240Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:46.5867450Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:46.5867681Z     # required to build '-native' target
2026-09-24T00:30:46.5867894Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:46.5868091Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:46.5868307Z   ccache-recipe-contol: |
2026-09-24T00:30:46.5868493Z     # disable all recipes
2026-09-24T00:30:46.5868706Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:46.5868892Z     # table with enabled recipes
2026-09-24T00:30:46.5869108Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:46.5869319Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:46.5869570Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:46.5869809Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:46.5870029Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:46.5870254Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:46.5870482Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:46.5870684Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:46.5870925Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:46.5871149Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:46.5871360Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:46.5871591Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:46.5871802Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:46.5872002Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:46.5872203Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:46.5872792Z   ci: |
2026-09-24T00:30:46.5873094Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:46.5873325Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:46.5873651Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:46.5873979Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:46.5874183Z   parallelism: |
2026-09-24T00:30:46.5874422Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:46.5874685Z     #
2026-09-24T00:30:46.5874956Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:46.5875294Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:46.5875615Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:46.5875938Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:46.5876292Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:46.5876639Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:46.5876976Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:46.5877317Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:46.5877615Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:46.5877823Z     #
2026-09-24T00:30:46.5878048Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:46.5878456Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:46.5878804Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:46.5879150Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:46.5879616Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:46.5879933Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:46.5880161Z     #
2026-09-24T00:30:46.5880382Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:46.5880711Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:46.5880987Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:46.5881194Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:46.5881390Z     do_compile[number_threads] = "8"
2026-09-24T00:30:46.5881591Z   git-dl: |
2026-09-24T00:30:46.5881808Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:46.5882119Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:46.5882429Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:46.5882684Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:46.5882989Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:46.5883214Z   git-shallow-kernels: |
2026-09-24T00:30:46.5883464Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:46.5883811Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:46.5884147Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:46.5884430Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:46.5884649Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:46.5884881Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"

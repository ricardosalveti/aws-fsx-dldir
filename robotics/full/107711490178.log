2026-09-24T15:50:37.7969277Z header:
2026-09-24T15:50:37.7969546Z   version: 14
2026-09-24T15:50:37.7969720Z local_conf_header:
2026-09-24T15:50:37.7969889Z   mirror: |
2026-09-24T15:50:37.7970253Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T15:50:37.7970587Z   ccache: |
2026-09-24T15:50:37.7970737Z     INHERIT += "ccache"
2026-09-24T15:50:37.7970909Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:50:37.7971142Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:50:37.7971379Z     # required to build '-native' target
2026-09-24T15:50:37.7971581Z     HOSTTOOLS += "ccache"
2026-09-24T15:50:37.7971771Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:50:37.7971975Z   ccache-recipe-contol: |
2026-09-24T15:50:37.7972171Z     # disable all recipes
2026-09-24T15:50:37.7972363Z     CCACHE_DISABLE = "1"
2026-09-24T15:50:37.7972607Z     # table with enabled recipes
2026-09-24T15:50:37.7972853Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:50:37.7973275Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:50:37.7973575Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:50:37.7973816Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:50:37.7974035Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:50:37.7974272Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:50:37.7974517Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:50:37.7974717Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:50:37.7974912Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:50:37.7975123Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:50:37.7975342Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:50:37.7975560Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:50:37.7975764Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:50:37.7975962Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:50:37.7976163Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:50:37.7976356Z   ci: |
2026-09-24T15:50:37.7976762Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:50:37.7976979Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:50:37.7977347Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:50:37.7977662Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:50:37.7977857Z   parallelism: |
2026-09-24T15:50:37.7978085Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:50:37.7978345Z     #
2026-09-24T15:50:37.7978730Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:50:37.7979068Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:50:37.7979389Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:50:37.7979725Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:50:37.7980068Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:50:37.7980413Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:50:37.7980741Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:50:37.7981101Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:50:37.7981461Z     # reach sstate, so re-running never helps.
2026-09-24T15:50:37.7981710Z     #
2026-09-24T15:50:37.7981936Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:50:37.7982291Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:50:37.7982640Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:50:37.7982981Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:50:37.7983319Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:50:37.7983757Z     # warm build, so neither setting costs anything there.
2026-09-24T15:50:37.7983994Z     #
2026-09-24T15:50:37.7984207Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:50:37.7984531Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:50:37.7984805Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:50:37.7985007Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:50:37.7985187Z     do_compile[number_threads] = "8"
2026-09-24T15:50:37.7985373Z   git-dl: |
2026-09-24T15:50:37.7985589Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:50:37.7985900Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:50:37.7986208Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:50:37.7986468Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:50:37.7986669Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:50:37.7986872Z   git-shallow-kernels: |
2026-09-24T15:50:37.7987119Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:50:37.7987452Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:50:37.7987802Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:50:37.7988077Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:50:37.7988290Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:50:37.7988640Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:50:37.7988902Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:50:37.7989112Z   base: |
2026-09-24T15:50:37.7989262Z     CONF_VERSION = "2"
2026-09-24T15:50:37.7989447Z     INHERIT += "buildstats-summary"
2026-09-24T15:50:37.7989650Z     INHERIT += "buildhistory"
2026-09-24T15:50:37.7989846Z     INHERIT += "rm_work"
2026-09-24T15:50:37.7990027Z     INHERIT += "image-buildinfo"
2026-09-24T15:50:37.7990210Z   diskmon: |
2026-09-24T15:50:37.7990366Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:50:37.7990566Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:50:37.7990847Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:50:37.7991046Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:50:37.7991249Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:50:37.7991450Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:50:37.7991640Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:50:37.7991831Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:50:37.7992026Z       HALT,/tmp,10M,1K"

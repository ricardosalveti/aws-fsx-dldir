2026-09-24T00:31:14.5893448Z local_conf_header:
2026-09-24T00:31:14.5893631Z   mirror: |
2026-09-24T00:31:14.5893997Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:31:14.5894337Z   ccache: |
2026-09-24T00:31:14.5894494Z     INHERIT += "ccache"
2026-09-24T00:31:14.5894677Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:31:14.5894889Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:31:14.5895149Z     # required to build '-native' target
2026-09-24T00:31:14.5895435Z     HOSTTOOLS += "ccache"
2026-09-24T00:31:14.5895671Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:31:14.5895903Z   ccache-recipe-contol: |
2026-09-24T00:31:14.5896083Z     # disable all recipes
2026-09-24T00:31:14.5896254Z     CCACHE_DISABLE = "1"
2026-09-24T00:31:14.5896589Z     # table with enabled recipes
2026-09-24T00:31:14.5896869Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:31:14.5897120Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:31:14.5897374Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:31:14.5897611Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:31:14.5897831Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:31:14.5898055Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:31:14.5898271Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:31:14.5898466Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:31:14.5898661Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:31:14.5898883Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:31:14.5899094Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:31:14.5899418Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:31:14.5899631Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:31:14.5899840Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:31:14.5900041Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:31:14.5900229Z   ci: |
2026-09-24T00:31:14.5900395Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:31:14.5900857Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:31:14.5901193Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:31:14.5901506Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:31:14.5901708Z   parallelism: |
2026-09-24T00:31:14.5902006Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:31:14.5902268Z     #
2026-09-24T00:31:14.5902496Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:31:14.5902832Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:31:14.5903155Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:31:14.5903480Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:31:14.5903829Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:31:14.5904176Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:31:14.5904509Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:31:14.5904840Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:31:14.5905133Z     # reach sstate, so re-running never helps.
2026-09-24T00:31:14.5905336Z     #
2026-09-24T00:31:14.5905559Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:31:14.5905901Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:31:14.5906283Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:31:14.5906786Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:31:14.5907141Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:31:14.5907547Z     # warm build, so neither setting costs anything there.
2026-09-24T00:31:14.5907779Z     #
2026-09-24T00:31:14.5907994Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:31:14.5908317Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:31:14.5908596Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:31:14.5908797Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:31:14.5908981Z     do_compile[number_threads] = "8"
2026-09-24T00:31:14.5909171Z   git-dl: |
2026-09-24T00:31:14.5909381Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:31:14.5909698Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:31:14.5910001Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:31:14.5910256Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:31:14.5910451Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:31:14.5910664Z   git-shallow-kernels: |
2026-09-24T00:31:14.5910911Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:31:14.5911242Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:31:14.5911574Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:31:14.5911853Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:31:14.5912052Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:31:14.5912272Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:31:14.5912499Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:31:14.5912710Z   base: |
2026-09-24T00:31:14.5912854Z     CONF_VERSION = "2"
2026-09-24T00:31:14.5913037Z     INHERIT += "buildstats-summary"
2026-09-24T00:31:14.5913239Z     INHERIT += "buildhistory"
2026-09-24T00:31:14.5913434Z     INHERIT += "rm_work"
2026-09-24T00:31:14.5913613Z     INHERIT += "image-buildinfo"
2026-09-24T00:31:14.5913796Z   diskmon: |
2026-09-24T00:31:14.5913955Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:31:14.5914141Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:31:14.5914423Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:31:14.5914620Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:31:14.5914822Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:31:14.5915009Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:31:14.5915202Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:31:14.5915388Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:31:14.5915575Z       HALT,/tmp,10M,1K"
2026-09-24T00:31:14.5915739Z   clo-mirrors: |
2026-09-24T00:31:14.5915906Z     MIRRORS:append = " \
2026-09-24T00:31:14.5916156Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T00:31:14.5916607Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T00:31:14.5916926Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T00:31:14.5917193Z     "
2026-09-24T00:31:14.5917338Z   cmdline: |

2026-09-24T00:30:43.2922682Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:43.2922940Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:43.2923186Z     # required to build '-native' target
2026-09-24T00:30:43.2923394Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:43.2923594Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:43.2923837Z   ccache-recipe-contol: |
2026-09-24T00:30:43.2924051Z     # disable all recipes
2026-09-24T00:30:43.2924258Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:43.2924472Z     # table with enabled recipes
2026-09-24T00:30:43.2924683Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:43.2924906Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:43.2925152Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:43.2925408Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:43.2925673Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:43.2925901Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:43.2926117Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:43.2926327Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:43.2926528Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:43.2926741Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:43.2926957Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:43.2927195Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:43.2927408Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:43.2927609Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:43.2927805Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:43.2927990Z   ci: |
2026-09-24T00:30:43.2928144Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:43.2928356Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:43.2928668Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:43.2929070Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:43.2929275Z   parallelism: |
2026-09-24T00:30:43.2929514Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:43.2929774Z     #
2026-09-24T00:30:43.2929990Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:43.2930332Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:43.2930808Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:43.2931144Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:43.2931484Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:43.2931837Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:43.2932176Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:43.2932511Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:43.2932802Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:43.2933010Z     #
2026-09-24T00:30:43.2933230Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:43.2933571Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:43.2933918Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:43.2934249Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:43.2934581Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:43.2934883Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:43.2935117Z     #
2026-09-24T00:30:43.2935399Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:43.2935725Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:43.2936000Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:43.2936212Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:43.2936403Z     do_compile[number_threads] = "8"
2026-09-24T00:30:43.2936597Z   git-dl: |
2026-09-24T00:30:43.2936805Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:43.2937120Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:43.2937435Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:43.2937692Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:43.2937898Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:43.2938131Z   git-shallow-kernels: |
2026-09-24T00:30:43.2938405Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:43.2938748Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:43.2939089Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:43.2939490Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:43.2939715Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:43.2939938Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:43.2940174Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:43.2940383Z   base: |
2026-09-24T00:30:43.2940649Z     CONF_VERSION = "2"
2026-09-24T00:30:43.2940877Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:43.2941086Z     INHERIT += "buildhistory"
2026-09-24T00:30:43.2941273Z     INHERIT += "rm_work"
2026-09-24T00:30:43.2941474Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:43.2941663Z   diskmon: |
2026-09-24T00:30:43.2941825Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:43.2942011Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:43.2942211Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:43.2942419Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:30:43.2942750Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:30:43.2942992Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:30:43.2943180Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:30:43.2943379Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:30:43.2943577Z       HALT,/tmp,10M,1K"
2026-09-24T00:30:43.2943759Z   clo-mirrors: |
2026-09-24T00:30:43.2943934Z     MIRRORS:append = " \
2026-09-24T00:30:43.2944212Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T00:30:43.2944536Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T00:30:43.2944848Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T00:30:43.2945104Z     "
2026-09-24T00:30:43.2945255Z   cmdline: |

2026-09-24T15:53:20.7771627Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:53:20.7771838Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:53:20.7772063Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:53:20.7772270Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:53:20.7772465Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:53:20.7772655Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:53:20.7772854Z   ci: |
2026-09-24T15:53:20.7773164Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:53:20.7773377Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:53:20.7773691Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:53:20.7774004Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:53:20.7774199Z   parallelism: |
2026-09-24T15:53:20.7774432Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:53:20.7774681Z     #
2026-09-24T15:53:20.7774900Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:53:20.7775233Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:53:20.7775552Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:53:20.7775870Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:53:20.7776258Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:53:20.7776596Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:53:20.7776928Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:53:20.7777247Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:53:20.7777527Z     # reach sstate, so re-running never helps.
2026-09-24T15:53:20.7777723Z     #
2026-09-24T15:53:20.7777943Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:53:20.7778276Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:53:20.7778620Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:53:20.7778978Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:53:20.7779318Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:53:20.7779695Z     # warm build, so neither setting costs anything there.
2026-09-24T15:53:20.7780056Z     #
2026-09-24T15:53:20.7780366Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:53:20.7780692Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:53:20.7780953Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:53:20.7781152Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:53:20.7781335Z     do_compile[number_threads] = "8"
2026-09-24T15:53:20.7781525Z   git-dl: |
2026-09-24T15:53:20.7781730Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:53:20.7782032Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:53:20.7782338Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:53:20.7782597Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:53:20.7782783Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:53:20.7782974Z   git-shallow-kernels: |
2026-09-24T15:53:20.7783221Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:53:20.7783557Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:53:20.7783892Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:53:20.7784162Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:53:20.7784370Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:53:20.7784587Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:53:20.7784810Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:53:20.7785014Z   base: |
2026-09-24T15:53:20.7785193Z     CONF_VERSION = "2"
2026-09-24T15:53:20.7785381Z     INHERIT += "buildstats-summary"
2026-09-24T15:53:20.7785583Z     INHERIT += "buildhistory"
2026-09-24T15:53:20.7785767Z     INHERIT += "rm_work"
2026-09-24T15:53:20.7785950Z     INHERIT += "image-buildinfo"
2026-09-24T15:53:20.7786142Z   diskmon: |
2026-09-24T15:53:20.7786296Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:53:20.7786484Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:53:20.7786746Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:53:20.7786936Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:53:20.7787139Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:53:20.7787324Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:53:20.7787504Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:53:20.7787683Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:53:20.7787873Z       HALT,/tmp,10M,1K"
2026-09-24T15:53:20.7788036Z   clo-mirrors: |

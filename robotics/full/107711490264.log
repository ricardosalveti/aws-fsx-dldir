2026-09-24T15:53:20.7767520Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:53:20.7767796Z     # required to build '-native' target
2026-09-24T15:53:20.7768298Z     HOSTTOOLS += "ccache"
2026-09-24T15:53:20.7768538Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:53:20.7768748Z   ccache-recipe-contol: |
2026-09-24T15:53:20.7768932Z     # disable all recipes

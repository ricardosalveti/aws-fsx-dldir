2026-09-24T15:53:20.7769297Z     # table with enabled recipes
2026-09-24T15:53:20.7769505Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:53:20.7769716Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:53:20.7770120Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:53:20.7770367Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:53:20.7770582Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:53:20.7770807Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"

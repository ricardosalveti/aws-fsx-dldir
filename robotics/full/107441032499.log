2026-09-24T00:30:53.5261593Z header:
2026-09-24T00:30:53.5261803Z   version: 14
2026-09-24T00:30:53.5261978Z local_conf_header:
2026-09-24T00:30:53.5262296Z   mirror: |
2026-09-24T00:30:53.5262643Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:30:53.5262960Z   ccache: |
2026-09-24T00:30:53.5263107Z     INHERIT += "ccache"
2026-09-24T00:30:53.5263292Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:53.5263477Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:53.5263733Z     # required to build '-native' target
2026-09-24T00:30:53.5263985Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:53.5264174Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:53.5264378Z   ccache-recipe-contol: |
2026-09-24T00:30:53.5264557Z     # disable all recipes
2026-09-24T00:30:53.5264728Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:53.5264919Z     # table with enabled recipes
2026-09-24T00:30:53.5265115Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:53.5265332Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:53.5265617Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:53.5265894Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:53.5266104Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:53.5266326Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:53.5266535Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:53.5266724Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:53.5266930Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:53.5267135Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:53.5267341Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:53.5267553Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:53.5267754Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:53.5267950Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:53.5268135Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:53.5268319Z   ci: |
2026-09-24T00:30:53.5268478Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:53.5268838Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:53.5269156Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:53.5269468Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:53.5269655Z   parallelism: |
2026-09-24T00:30:53.5269891Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:53.5270143Z     #
2026-09-24T00:30:53.5270354Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:53.5270681Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:53.5271000Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:53.5271312Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:53.5271630Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:53.5271969Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:53.5272448Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:53.5272777Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:53.5273068Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:53.5273264Z     #
2026-09-24T00:30:53.5273495Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:53.5273897Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:53.5274282Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:53.5274622Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:53.5274959Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:53.5275265Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:53.5275559Z     #
2026-09-24T00:30:53.5275774Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:53.5276105Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:53.5276375Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:53.5276579Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:53.5276768Z     do_compile[number_threads] = "8"
2026-09-24T00:30:53.5276969Z   git-dl: |
2026-09-24T00:30:53.5277178Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:53.5277487Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:53.5277795Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:53.5278057Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:53.5278251Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:53.5278451Z   git-shallow-kernels: |
2026-09-24T00:30:53.5278695Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:53.5279032Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:53.5279361Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:53.5279632Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:53.5279841Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:53.5280063Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:53.5280288Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:53.5280486Z   base: |
2026-09-24T00:30:53.5280633Z     CONF_VERSION = "2"
2026-09-24T00:30:53.5280819Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:53.5281018Z     INHERIT += "buildhistory"
2026-09-24T00:30:53.5281189Z     INHERIT += "rm_work"
2026-09-24T00:30:53.5281357Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:53.5281535Z   diskmon: |
2026-09-24T00:30:53.5281695Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:53.5281879Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:53.5282207Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:53.5282483Z       STOPTASKS,${SSTATE_DIR},1G,100K \

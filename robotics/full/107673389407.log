2026-09-24T00:30:48.8717547Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:48.8717832Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:48.8718103Z     # required to build '-native' target
2026-09-24T00:30:48.8718310Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:48.8718514Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:48.8718904Z   ccache-recipe-contol: |
2026-09-24T00:30:48.8719086Z     # disable all recipes
2026-09-24T00:30:48.8719262Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:48.8719476Z     # table with enabled recipes
2026-09-24T00:30:48.8719710Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:48.8719923Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:48.8720156Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:48.8720389Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:48.8720598Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:48.8720832Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:48.8721069Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:48.8721264Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:48.8721461Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:48.8721679Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:48.8721892Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:48.8722106Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:48.8722306Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:48.8722501Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:48.8722686Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:48.8723294Z   ci: |
2026-09-24T00:30:48.8723452Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:48.8723681Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:48.8724002Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:48.8724320Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:48.8724517Z   parallelism: |
2026-09-24T00:30:48.8724746Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:48.8725017Z     #
2026-09-24T00:30:48.8725233Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:48.8725570Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:48.8726015Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:48.8726347Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:48.8726698Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:48.8727053Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:48.8727395Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:48.8727727Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:48.8728017Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:48.8728217Z     #
2026-09-24T00:30:48.8728445Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:48.8728792Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:48.8729143Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:48.8729480Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:48.8729938Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:48.8730261Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:48.8730485Z     #
2026-09-24T00:30:48.8730732Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:48.8731065Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:48.8731345Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:48.8731545Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:48.8731730Z     do_compile[number_threads] = "8"
2026-09-24T00:30:48.8731917Z   git-dl: |
2026-09-24T00:30:48.8732125Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:48.8732450Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:48.8732760Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:48.8733018Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:48.8733213Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:48.8733424Z   git-shallow-kernels: |
2026-09-24T00:30:48.8733670Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:48.8734007Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:48.8734342Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:48.8734616Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:48.8734816Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:48.8735031Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:48.8735260Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:48.8735468Z   base: |
2026-09-24T00:30:48.8735610Z     CONF_VERSION = "2"
2026-09-24T00:30:48.8735906Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:48.8736111Z     INHERIT += "buildhistory"
2026-09-24T00:30:48.8736301Z     INHERIT += "rm_work"
2026-09-24T00:30:48.8736480Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:48.8736666Z   diskmon: |
2026-09-24T00:30:48.8736897Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:48.8737089Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:48.8737287Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:48.8737481Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:30:48.8737683Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:30:48.8737873Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:30:48.8738068Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:30:48.8738248Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:30:48.8738489Z       HALT,/tmp,10M,1K"
2026-09-24T00:30:48.8738651Z   clo-mirrors: |
2026-09-24T00:30:48.8738815Z     MIRRORS:append = " \

2026-09-24T14:19:09.0299288Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T14:19:09.0299513Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T14:19:09.0299723Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T14:19:09.0299934Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T14:19:09.0300124Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T14:19:09.0300309Z   ci: |
2026-09-24T14:19:09.0300464Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T14:19:09.0300702Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T14:19:09.0301144Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T14:19:09.0301473Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T14:19:09.0301669Z   parallelism: |
2026-09-24T14:19:09.0301920Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T14:19:09.0302188Z     #
2026-09-24T14:19:09.0302409Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T14:19:09.0302751Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T14:19:09.0303086Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T14:19:09.0303400Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T14:19:09.0303729Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T14:19:09.0304080Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T14:19:09.0304433Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T14:19:09.0304770Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T14:19:09.0305061Z     # reach sstate, so re-running never helps.
2026-09-24T14:19:09.0305262Z     #
2026-09-24T14:19:09.0305495Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T14:19:09.0305850Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T14:19:09.0306206Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T14:19:09.0306555Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T14:19:09.0306907Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T14:19:09.0307219Z     # warm build, so neither setting costs anything there.
2026-09-24T14:19:09.0307442Z     #
2026-09-24T14:19:09.0307754Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T14:19:09.0308091Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T14:19:09.0308488Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T14:19:09.0308712Z     PARALLEL_MAKE = "-j 4"
2026-09-24T14:19:09.0308914Z     do_compile[number_threads] = "8"
2026-09-24T14:19:09.0309108Z   git-dl: |
2026-09-24T14:19:09.0309328Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T14:19:09.0309651Z     # update them concurrently: keep them job-local and share history
2026-09-24T14:19:09.0309980Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T14:19:09.0310242Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T14:19:09.0310440Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T14:19:09.0310642Z   git-shallow-kernels: |
2026-09-24T14:19:09.0310898Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T14:19:09.0311246Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T14:19:09.0311599Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T14:19:09.0311879Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T14:19:09.0312099Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T14:19:09.0312323Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T14:19:09.0312556Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T14:19:09.0312753Z   base: |
2026-09-24T14:19:09.0312897Z     CONF_VERSION = "2"
2026-09-24T14:19:09.0313084Z     INHERIT += "buildstats-summary"
2026-09-24T14:19:09.0313286Z     INHERIT += "buildhistory"
2026-09-24T14:19:09.0313470Z     INHERIT += "rm_work"
2026-09-24T14:19:09.0313647Z     INHERIT += "image-buildinfo"
2026-09-24T14:19:09.0313838Z   diskmon: |
2026-09-24T14:19:09.0313988Z     BB_DISKMON_DIRS ??= "\
2026-09-24T14:19:09.0314168Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T14:19:09.0314361Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T14:19:09.0314569Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T14:19:09.0314843Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T14:19:09.0315029Z       HALT,${TMPDIR},100M,1K \
2026-09-24T14:19:09.0315216Z       HALT,${DL_DIR},100M,1K \
2026-09-24T14:19:09.0315410Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T14:19:09.0315601Z       HALT,/tmp,10M,1K"

2026-09-24T15:51:32.1433560Z 
2026-09-24T15:51:32.1433644Z     BB_NUMBER_PARSE_THREADS ?= "${CPU_COUNT}"
2026-09-24T15:51:32.1433794Z 
2026-09-24T15:51:32.1433978Z     # Specifies a maximum CPU pressure threshold for bitbake scheduler to start new tasks.
2026-09-24T15:51:32.1434215Z 
2026-09-24T15:51:32.1434301Z     BB_PRESSURE_MAX_CPU = "800000"
2026-09-24T15:51:32.1434489Z 
2026-09-24T15:51:32.1434492Z 
2026-09-24T15:51:32.1434661Z     # Specifies a maximum IO pressure threshold for bitbake scheduler to start new tasks.
2026-09-24T15:51:32.1434899Z 
2026-09-24T15:51:32.1434978Z     BB_PRESSURE_MAX_IO = "800000"
2026-09-24T15:51:32.1435099Z 
2026-09-24T15:51:32.1435102Z 
2026-09-24T15:51:32.1435279Z     # Specifies a maximum Memory pressure threshold for bitbake scheduler to start new tasks.
2026-09-24T15:51:32.1435525Z 
2026-09-24T15:51:32.1435599Z     BB_PRESSURE_MAX_MEMORY = "800000"
2026-09-24T15:51:32.1435734Z 
2026-09-24T15:51:32.1435737Z 
2026-09-24T15:51:32.1435911Z     # Determines how many processes make should run in parallel when running compile tasks.
2026-09-24T15:51:32.1436146Z 
2026-09-24T15:51:32.1436264Z     PARALLEL_MAKE ?= "-j${THREAD_COUNT} -l${THREAD_COUNT}"

2026-09-24T15:51:32.1431989Z     # Capture the count of cpu cores available from the export variable.
2026-09-24T15:51:32.1432179Z 
2026-09-24T15:51:32.1432280Z     CPU_COUNT = "${@os.getenv('CPU_COUNT', '12')}"
2026-09-24T15:51:32.1432432Z 

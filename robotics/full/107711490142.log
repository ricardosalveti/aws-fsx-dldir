2026-09-24T15:51:32.1412133Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:51:32.1412348Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:51:32.1412666Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:51:32.1412997Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:51:32.1413202Z   parallelism: |
2026-09-24T15:51:32.1413436Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:51:32.1413701Z     #
2026-09-24T15:51:32.1413925Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:51:32.1414261Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:51:32.1414701Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:51:32.1415074Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:51:32.1415577Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:51:32.1415940Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:51:32.1416269Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:51:32.1416598Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:51:32.1416892Z     # reach sstate, so re-running never helps.
2026-09-24T15:51:32.1417209Z     #
2026-09-24T15:51:32.1417425Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:51:32.1417767Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:51:32.1418129Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:51:32.1418468Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:51:32.1418805Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:51:32.1419109Z     # warm build, so neither setting costs anything there.
2026-09-24T15:51:32.1419347Z     #
2026-09-24T15:51:32.1419568Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:51:32.1419900Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:51:32.1420171Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:51:32.1420381Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:51:32.1420564Z     do_compile[number_threads] = "8"
2026-09-24T15:51:32.1420742Z   git-dl: |
2026-09-24T15:51:32.1420934Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:51:32.1421246Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:51:32.1421560Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:51:32.1421913Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:51:32.1422113Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:51:32.1422331Z   git-shallow-kernels: |
2026-09-24T15:51:32.1422591Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:51:32.1422932Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:51:32.1423280Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:51:32.1423584Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:51:32.1423803Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:51:32.1424024Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:51:32.1424254Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:51:32.1424471Z   base: |
2026-09-24T15:51:32.1424626Z     CONF_VERSION = "2"
2026-09-24T15:51:32.1424806Z     INHERIT += "buildstats-summary"
2026-09-24T15:51:32.1425016Z     INHERIT += "buildhistory"
2026-09-24T15:51:32.1425212Z     INHERIT += "rm_work"
2026-09-24T15:51:32.1425392Z     INHERIT += "image-buildinfo"
2026-09-24T15:51:32.1425575Z   diskmon: |
2026-09-24T15:51:32.1425731Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:51:32.1425920Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:51:32.1426125Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:51:32.1426317Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:51:32.1426519Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:51:32.1426711Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:51:32.1426904Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:51:32.1427194Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:51:32.1427390Z       HALT,/tmp,10M,1K"
2026-09-24T15:51:32.1427557Z   clo-mirrors: |
2026-09-24T15:51:32.1427731Z     MIRRORS:append = " \
2026-09-24T15:51:32.1427993Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T15:51:32.1428395Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:51:32.1428712Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T15:51:32.1428986Z     "
2026-09-24T15:51:32.1429133Z   cmdline: |

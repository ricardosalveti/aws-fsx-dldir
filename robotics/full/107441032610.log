2026-09-24T00:33:08.0740312Z header:
2026-09-24T00:33:08.0740485Z   version: 14
2026-09-24T00:33:08.0740664Z local_conf_header:
2026-09-24T00:33:08.0740831Z   mirror: |
2026-09-24T00:33:08.0741184Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:33:08.0741521Z   ccache: |
2026-09-24T00:33:08.0741680Z     INHERIT += "ccache"
2026-09-24T00:33:08.0741861Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:33:08.0742060Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:33:08.0742285Z     # required to build '-native' target
2026-09-24T00:33:08.0742503Z     HOSTTOOLS += "ccache"
2026-09-24T00:33:08.0742794Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:33:08.0743080Z   ccache-recipe-contol: |
2026-09-24T00:33:08.0743272Z     # disable all recipes
2026-09-24T00:33:08.0743467Z     CCACHE_DISABLE = "1"
2026-09-24T00:33:08.0743760Z     # table with enabled recipes
2026-09-24T00:33:08.0744002Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:33:08.0744213Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:33:08.0744449Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:33:08.0744692Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:33:08.0744905Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:33:08.0745131Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:33:08.0745343Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:33:08.0745547Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:33:08.0745743Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:33:08.0745958Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:33:08.0746177Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:33:08.0746398Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:33:08.0746612Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:33:08.0746810Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:33:08.0747002Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:33:08.0747354Z   ci: |
2026-09-24T00:33:08.0747520Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:33:08.0747745Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:33:08.0748070Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:33:08.0748389Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:33:08.0748762Z   parallelism: |
2026-09-24T00:33:08.0749014Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:33:08.0749281Z     #
2026-09-24T00:33:08.0749500Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:33:08.0749849Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:33:08.0750180Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:33:08.0750507Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:33:08.0750852Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:33:08.0751213Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:33:08.0751552Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:33:08.0751885Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:33:08.0752171Z     # reach sstate, so re-running never helps.
2026-09-24T00:33:08.0752384Z     #
2026-09-24T00:33:08.0752606Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:33:08.0752961Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:33:08.0753361Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:33:08.0753718Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:33:08.0754175Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:33:08.0754553Z     # warm build, so neither setting costs anything there.
2026-09-24T00:33:08.0754788Z     #
2026-09-24T00:33:08.0755007Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:33:08.0755348Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:33:08.0755622Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:33:08.0755829Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:33:08.0756020Z     do_compile[number_threads] = "8"
2026-09-24T00:33:08.0756213Z   git-dl: |
2026-09-24T00:33:08.0756442Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:33:08.0756764Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:33:08.0757089Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:33:08.0757355Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:33:08.0757565Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:33:08.0757767Z   git-shallow-kernels: |
2026-09-24T00:33:08.0758020Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:33:08.0758359Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:33:08.0758859Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:33:08.0759151Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:33:08.0759368Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:33:08.0759595Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:33:08.0759843Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:33:08.0760052Z   base: |
2026-09-24T00:33:08.0760202Z     CONF_VERSION = "2"
2026-09-24T00:33:08.0760384Z     INHERIT += "buildstats-summary"
2026-09-24T00:33:08.0760595Z     INHERIT += "buildhistory"
2026-09-24T00:33:08.0760783Z     INHERIT += "rm_work"
2026-09-24T00:33:08.0760967Z     INHERIT += "image-buildinfo"
2026-09-24T00:33:08.0761156Z   diskmon: |
2026-09-24T00:33:08.0761315Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:33:08.0761585Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:33:08.0761788Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:33:08.0761991Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:33:08.0762193Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:33:08.0762398Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:33:08.0762586Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:33:08.0762770Z       HALT,${SSTATE_DIR},100M,1K \

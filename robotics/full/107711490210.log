2026-09-24T15:50:54.3892829Z local_conf_header:
2026-09-24T15:50:54.3893052Z   mirror: |
2026-09-24T15:50:54.3893389Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T15:50:54.3893723Z   ccache: |

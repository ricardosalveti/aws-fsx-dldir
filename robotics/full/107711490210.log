2026-09-24T15:50:54.3894052Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:50:54.3894244Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:50:54.3894476Z     # required to build '-native' target
2026-09-24T15:50:54.3894681Z     HOSTTOOLS += "ccache"
2026-09-24T15:50:54.3894876Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:50:54.3895085Z   ccache-recipe-contol: |
2026-09-24T15:50:54.3895279Z     # disable all recipes
2026-09-24T15:50:54.3895456Z     CCACHE_DISABLE = "1"
2026-09-24T15:50:54.3895663Z     # table with enabled recipes
2026-09-24T15:50:54.3895879Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:50:54.3896112Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:50:54.3896377Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:50:54.3896669Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:50:54.3896882Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:50:54.3897117Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:50:54.3897336Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:50:54.3897527Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:50:54.3897734Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:50:54.3897949Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:50:54.3898164Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:50:54.3898384Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:50:54.3898604Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:50:54.3898804Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:50:54.3899007Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:50:54.3899415Z   ci: |
2026-09-24T15:50:54.3899796Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:50:54.3900023Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:50:54.3900396Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:50:54.3900711Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:50:54.3900918Z   parallelism: |
2026-09-24T15:50:54.3901153Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:50:54.3901417Z     #
2026-09-24T15:50:54.3901637Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:50:54.3901987Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:50:54.3902312Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:50:54.3902637Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:50:54.3902986Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:50:54.3903337Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:50:54.3903671Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:50:54.3903995Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:50:54.3904281Z     # reach sstate, so re-running never helps.
2026-09-24T15:50:54.3904491Z     #
2026-09-24T15:50:54.3904712Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:50:54.3905048Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:50:54.3905397Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:50:54.3905740Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:50:54.3906184Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:50:54.3906504Z     # warm build, so neither setting costs anything there.
2026-09-24T15:50:54.3906728Z     #
2026-09-24T15:50:54.3906957Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:50:54.3907293Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:50:54.3907571Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:50:54.3907776Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:50:54.3907970Z     do_compile[number_threads] = "8"
2026-09-24T15:50:54.3908167Z   git-dl: |
2026-09-24T15:50:54.3908377Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:50:54.3908694Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:50:54.3909007Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:50:54.3909251Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:50:54.3909444Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:50:54.3909831Z   git-shallow-kernels: |
2026-09-24T15:50:54.3910108Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:50:54.3910452Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:50:54.3910790Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:50:54.3911073Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:50:54.3911301Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:50:54.3911523Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:50:54.3911758Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:50:54.3911968Z   base: |
2026-09-24T15:50:54.3912128Z     CONF_VERSION = "2"
2026-09-24T15:50:54.3912312Z     INHERIT += "buildstats-summary"
2026-09-24T15:50:54.3912515Z     INHERIT += "buildhistory"
2026-09-24T15:50:54.3912699Z     INHERIT += "rm_work"
2026-09-24T15:50:54.3912883Z     INHERIT += "image-buildinfo"
2026-09-24T15:50:54.3913079Z   diskmon: |
2026-09-24T15:50:54.3913240Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:50:54.3913507Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:50:54.3913702Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:50:54.3913913Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:50:54.3914115Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:50:54.3914313Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:50:54.3914499Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:50:54.3914691Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:50:54.3914879Z       HALT,/tmp,10M,1K"
2026-09-24T15:50:54.3915055Z   clo-mirrors: |
2026-09-24T15:50:54.3915221Z     MIRRORS:append = " \
2026-09-24T15:50:54.3915476Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T15:50:54.3915806Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:50:54.3916114Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \

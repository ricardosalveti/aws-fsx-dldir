2026-09-24T00:31:14.9911718Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:31:14.9912056Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:31:14.9912376Z     # required to build '-native' target
2026-09-24T00:31:14.9912638Z     HOSTTOOLS += "ccache"
2026-09-24T00:31:14.9912832Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:31:14.9913074Z   ccache-recipe-contol: |
2026-09-24T00:31:14.9913303Z     # disable all recipes
2026-09-24T00:31:14.9913543Z     CCACHE_DISABLE = "1"
2026-09-24T00:31:14.9913825Z     # table with enabled recipes
2026-09-24T00:31:14.9914164Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:31:14.9914415Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:31:14.9914699Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:31:14.9914970Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:31:14.9915191Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:31:14.9915416Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:31:14.9915622Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:31:14.9915818Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:31:14.9916027Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:31:14.9916235Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:31:14.9916449Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:31:14.9916666Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:31:14.9916869Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:31:14.9917068Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:31:14.9917270Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:31:14.9917659Z   ci: |
2026-09-24T00:31:14.9917825Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:31:14.9918058Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:31:14.9918548Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:31:14.9918869Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:31:14.9919066Z   parallelism: |
2026-09-24T00:31:14.9919309Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:31:14.9919563Z     #
2026-09-24T00:31:14.9919779Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:31:14.9920109Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:31:14.9920436Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:31:14.9920752Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:31:14.9921080Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:31:14.9921416Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:31:14.9921752Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:31:14.9922109Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:31:14.9922394Z     # reach sstate, so re-running never helps.
2026-09-24T00:31:14.9922594Z     #
2026-09-24T00:31:14.9922818Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:31:14.9923154Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:31:14.9923496Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:31:14.9923830Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:31:14.9924284Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:31:14.9924598Z     # warm build, so neither setting costs anything there.
2026-09-24T00:31:14.9924821Z     #
2026-09-24T00:31:14.9925030Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:31:14.9925362Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:31:14.9925625Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:31:14.9925827Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:31:14.9926016Z     do_compile[number_threads] = "8"
2026-09-24T00:31:14.9926213Z   git-dl: |
2026-09-24T00:31:14.9926419Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:31:14.9926726Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:31:14.9927033Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:31:14.9927295Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:31:14.9927485Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:31:14.9927686Z   git-shallow-kernels: |
2026-09-24T00:31:14.9927933Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:31:14.9928396Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:31:14.9928747Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:31:14.9929028Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:31:14.9929238Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:31:14.9929466Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:31:14.9929695Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:31:14.9929902Z   base: |
2026-09-24T00:31:14.9930048Z     CONF_VERSION = "2"
2026-09-24T00:31:14.9930235Z     INHERIT += "buildstats-summary"
2026-09-24T00:31:14.9930431Z     INHERIT += "buildhistory"
2026-09-24T00:31:14.9930609Z     INHERIT += "rm_work"
2026-09-24T00:31:14.9930783Z     INHERIT += "image-buildinfo"
2026-09-24T00:31:14.9930970Z   diskmon: |
2026-09-24T00:31:14.9931126Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:31:14.9931390Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:31:14.9931581Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:31:14.9931771Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:31:14.9931982Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:31:14.9932173Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:31:14.9932357Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:31:14.9932539Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:31:14.9932736Z       HALT,/tmp,10M,1K"
2026-09-24T00:31:14.9932901Z   clo-mirrors: |
2026-09-24T00:31:14.9933063Z     MIRRORS:append = " \
2026-09-24T00:31:14.9933315Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T00:31:14.9933633Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T00:31:14.9933935Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T00:31:14.9934179Z     "
2026-09-24T00:31:14.9934309Z   cmdline: |
2026-09-24T00:31:14.9934504Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"
2026-09-24T00:31:14.9934745Z   extra: |
2026-09-24T00:31:14.9934928Z     DISTRO_FEATURES:append = " efi pam pni-names"

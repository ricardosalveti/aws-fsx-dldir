2026-09-24T15:50:23.7840557Z   mirror: |
2026-09-24T15:50:23.7840893Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T15:50:23.7841253Z   ccache: |
2026-09-24T15:50:23.7841410Z     INHERIT += "ccache"
2026-09-24T15:50:23.7841590Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:50:23.7841810Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:50:23.7842110Z     # required to build '-native' target
2026-09-24T15:50:23.7842328Z     HOSTTOOLS += "ccache"
2026-09-24T15:50:23.7842530Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:50:23.7842748Z   ccache-recipe-contol: |
2026-09-24T15:50:23.7842959Z     # disable all recipes
2026-09-24T15:50:23.7843223Z     CCACHE_DISABLE = "1"
2026-09-24T15:50:23.7843417Z     # table with enabled recipes
2026-09-24T15:50:23.7843624Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:50:23.7843844Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:50:23.7844211Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:50:23.7844456Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:50:23.7844671Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:50:23.7844913Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:50:23.7845127Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:50:23.7845327Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:50:23.7845531Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:50:23.7845746Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:50:23.7845967Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:50:23.7846188Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:50:23.7846400Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:50:23.7846603Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:50:23.7846812Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:50:23.7847004Z   ci: |
2026-09-24T15:50:23.7847168Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:50:23.7847516Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:50:23.7847958Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:50:23.7848281Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:50:23.7848483Z   parallelism: |
2026-09-24T15:50:23.7848724Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:50:23.7849001Z     #
2026-09-24T15:50:23.7849224Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:50:23.7849560Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:50:23.7849888Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:50:23.7850221Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:50:23.7850558Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:50:23.7850904Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:50:23.7851249Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:50:23.7851634Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:50:23.7851922Z     # reach sstate, so re-running never helps.
2026-09-24T15:50:23.7852140Z     #
2026-09-24T15:50:23.7852364Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:50:23.7852708Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:50:23.7853057Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:50:23.7853399Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:50:23.7853733Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:50:23.7854256Z     # warm build, so neither setting costs anything there.
2026-09-24T15:50:23.7854503Z     #
2026-09-24T15:50:23.7854719Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:50:23.7855049Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:50:23.7855321Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:50:23.7855539Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:50:23.7855731Z     do_compile[number_threads] = "8"
2026-09-24T15:50:23.7855925Z   git-dl: |
2026-09-24T15:50:23.7856141Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:50:23.7856455Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:50:23.7856775Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:50:23.7857039Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:50:23.7857237Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:50:23.7857447Z   git-shallow-kernels: |
2026-09-24T15:50:23.7857709Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:50:23.7858046Z     # repository under one DL_DIR lock; nothing needs its history, so fetch

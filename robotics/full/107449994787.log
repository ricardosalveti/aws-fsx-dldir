2026-09-24T00:30:46.3230353Z header:
2026-09-24T00:30:46.3230599Z   version: 14
2026-09-24T00:30:46.3230812Z local_conf_header:
2026-09-24T00:30:46.3231014Z   mirror: |
2026-09-24T00:30:46.3231391Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:30:46.3231880Z   ccache: |
2026-09-24T00:30:46.3232085Z     INHERIT += "ccache"
2026-09-24T00:30:46.3232299Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:46.3232565Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:46.3232859Z     # required to build '-native' target
2026-09-24T00:30:46.3233149Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:46.3233458Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:46.3233718Z   ccache-recipe-contol: |
2026-09-24T00:30:46.3233915Z     # disable all recipes
2026-09-24T00:30:46.3234130Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:46.3234326Z     # table with enabled recipes
2026-09-24T00:30:46.3234529Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:46.3234737Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:46.3234984Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:46.3235222Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:46.3235441Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:46.3235674Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:46.3235887Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:46.3236091Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:46.3236294Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:46.3236504Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:46.3236718Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:46.3236944Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:46.3237155Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:46.3237357Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:46.3237556Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:46.3237980Z   ci: |
2026-09-24T00:30:46.3238145Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:46.3238415Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:46.3238747Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:46.3239075Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:46.3239276Z   parallelism: |
2026-09-24T00:30:46.3239522Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:46.3239789Z     #
2026-09-24T00:30:46.3240008Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:46.3240504Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:46.3240855Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:46.3241198Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:46.3241587Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:46.3241939Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:46.3242296Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:46.3242635Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:46.3242924Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:46.3243130Z     #
2026-09-24T00:30:46.3243365Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:46.3243713Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:46.3244070Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:46.3244414Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:46.3244876Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:46.3245203Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:46.3245433Z     #
2026-09-24T00:30:46.3245656Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:46.3246008Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:46.3246287Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:46.3246499Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:46.3246689Z     do_compile[number_threads] = "8"
2026-09-24T00:30:46.3246887Z   git-dl: |
2026-09-24T00:30:46.3247105Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:46.3247459Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:46.3247777Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:46.3248038Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:46.3248242Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:46.3248461Z   git-shallow-kernels: |
2026-09-24T00:30:46.3248713Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:46.3249055Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:46.3249405Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:46.3249707Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:46.3249925Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:46.3250155Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"

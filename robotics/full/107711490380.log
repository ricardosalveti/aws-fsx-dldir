2026-09-24T15:53:32.3729735Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:53:32.3729974Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:53:32.3730307Z     # required to build '-native' target
2026-09-24T15:53:32.3730561Z     HOSTTOOLS += "ccache"
2026-09-24T15:53:32.3730849Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:53:32.3731282Z   ccache-recipe-contol: |
2026-09-24T15:53:32.3731480Z     # disable all recipes
2026-09-24T15:53:32.3731653Z     CCACHE_DISABLE = "1"
2026-09-24T15:53:32.3731879Z     # table with enabled recipes
2026-09-24T15:53:32.3732129Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:53:32.3732355Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:53:32.3732594Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:53:32.3732834Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:53:32.3733051Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:53:32.3733272Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:53:32.3733480Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:53:32.3733673Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:53:32.3733880Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:53:32.3734086Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:53:32.3734292Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:53:32.3734510Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:53:32.3734720Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:53:32.3734921Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:53:32.3735111Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:53:32.3735301Z   ci: |
2026-09-24T15:53:32.3735711Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:53:32.3735934Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:53:32.3736434Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:53:32.3736755Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:53:32.3737059Z   parallelism: |
2026-09-24T15:53:32.3737304Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:53:32.3737569Z     #
2026-09-24T15:53:32.3737786Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:53:32.3738120Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:53:32.3738455Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:53:32.3738781Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:53:32.3739119Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:53:32.3739469Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:53:32.3739800Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:53:32.3740126Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:53:32.3740406Z     # reach sstate, so re-running never helps.
2026-09-24T15:53:32.3740611Z     #
2026-09-24T15:53:32.3740830Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:53:32.3741166Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:53:32.3741506Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:53:32.3741851Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:53:32.3742182Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:53:32.3742600Z     # warm build, so neither setting costs anything there.
2026-09-24T15:53:32.3742827Z     #
2026-09-24T15:53:32.3743048Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:53:32.3743372Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:53:32.3743642Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:53:32.3743848Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:53:32.3744045Z     do_compile[number_threads] = "8"
2026-09-24T15:53:32.3744240Z   git-dl: |
2026-09-24T15:53:32.3744452Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:53:32.3744765Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:53:32.3745076Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:53:32.3745330Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:53:32.3745521Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:53:32.3745717Z   git-shallow-kernels: |
2026-09-24T15:53:32.3745972Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:53:32.3746435Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:53:32.3746783Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:53:32.3747064Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:53:32.3747286Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:53:32.3747506Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:53:32.3747739Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:53:32.3747946Z   base: |
2026-09-24T15:53:32.3748091Z     CONF_VERSION = "2"
2026-09-24T15:53:32.3748282Z     INHERIT += "buildstats-summary"
2026-09-24T15:53:32.3748491Z     INHERIT += "buildhistory"
2026-09-24T15:53:32.3748677Z     INHERIT += "rm_work"
2026-09-24T15:53:32.3748860Z     INHERIT += "image-buildinfo"
2026-09-24T15:53:32.3749050Z   diskmon: |
2026-09-24T15:53:32.3749205Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:53:32.3749472Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:53:32.3749665Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:53:32.3749870Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:53:32.3750073Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:53:32.3750263Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:53:32.3750446Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:53:32.3750630Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:53:32.3750826Z       HALT,/tmp,10M,1K"
2026-09-24T15:53:32.3750995Z   clo-mirrors: |
2026-09-24T15:53:32.3751162Z     MIRRORS:append = " \
2026-09-24T15:53:32.3751410Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T15:53:32.3751730Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:53:32.3752036Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T15:53:32.3752277Z     "
2026-09-24T15:53:32.3752402Z   cmdline: |
2026-09-24T15:53:32.3752595Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"
2026-09-24T15:53:32.3752976Z   extra: |
2026-09-24T15:53:32.3753158Z     DISTRO_FEATURES:append = " efi pam pni-names"

2026-09-24T15:53:17.7785654Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:53:17.7785920Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:53:17.7786188Z     # required to build '-native' target
2026-09-24T15:53:17.7786401Z     HOSTTOOLS += "ccache"
2026-09-24T15:53:17.7786687Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:53:17.7786904Z   ccache-recipe-contol: |
2026-09-24T15:53:17.7787102Z     # disable all recipes
2026-09-24T15:53:17.7787449Z     CCACHE_DISABLE = "1"
2026-09-24T15:53:17.7787713Z     # table with enabled recipes
2026-09-24T15:53:17.7787922Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:53:17.7788151Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:53:17.7788392Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:53:17.7788623Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:53:17.7788829Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:53:17.7789056Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:53:17.7789276Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:53:17.7789477Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:53:17.7789676Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:53:17.7789890Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:53:17.7790113Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:53:17.7790332Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:53:17.7790539Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:53:17.7790742Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:53:17.7790947Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:53:17.7791138Z   ci: |
2026-09-24T15:53:17.7791522Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:53:17.7791748Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:53:17.7792090Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:53:17.7792414Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:53:17.7792610Z   parallelism: |
2026-09-24T15:53:17.7792847Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:53:17.7793117Z     #
2026-09-24T15:53:17.7793336Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:53:17.7793683Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:53:17.7794010Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:53:17.7794347Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:53:17.7794689Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:53:17.7795039Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:53:17.7795374Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:53:17.7795721Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:53:17.7796012Z     # reach sstate, so re-running never helps.
2026-09-24T15:53:17.7796214Z     #
2026-09-24T15:53:17.7796437Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:53:17.7796795Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:53:17.7797151Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:53:17.7797637Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:53:17.7798046Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:53:17.7798483Z     # warm build, so neither setting costs anything there.
2026-09-24T15:53:17.7798725Z     #
2026-09-24T15:53:17.7798964Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:53:17.7799306Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:53:17.7799590Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:53:17.7799801Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:53:17.7800006Z     do_compile[number_threads] = "8"
2026-09-24T15:53:17.7800202Z   git-dl: |
2026-09-24T15:53:17.7800419Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:53:17.7800742Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:53:17.7801076Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:53:17.7801347Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:53:17.7801550Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:53:17.7801762Z   git-shallow-kernels: |
2026-09-24T15:53:17.7802029Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:53:17.7802381Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:53:17.7802733Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:53:17.7803026Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:53:17.7803253Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:53:17.7803470Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:53:17.7803702Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:53:17.7803920Z   base: |
2026-09-24T15:53:17.7804082Z     CONF_VERSION = "2"
2026-09-24T15:53:17.7804271Z     INHERIT += "buildstats-summary"
2026-09-24T15:53:17.7804484Z     INHERIT += "buildhistory"
2026-09-24T15:53:17.7804675Z     INHERIT += "rm_work"
2026-09-24T15:53:17.7804863Z     INHERIT += "image-buildinfo"
2026-09-24T15:53:17.7805061Z   diskmon: |
2026-09-24T15:53:17.7805226Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:53:17.7805480Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:53:17.7805679Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:53:17.7805890Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:53:17.7806094Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:53:17.7806289Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:53:17.7806479Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:53:17.7806673Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:53:17.7806865Z       HALT,/tmp,10M,1K"
2026-09-24T15:53:17.7807034Z   clo-mirrors: |
2026-09-24T15:53:17.7807324Z     MIRRORS:append = " \

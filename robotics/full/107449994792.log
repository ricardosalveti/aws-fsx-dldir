2026-09-24T00:30:42.9826731Z   mirror: |
2026-09-24T00:30:42.9827145Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:30:42.9827816Z   ccache: |
2026-09-24T00:30:42.9828039Z     INHERIT += "ccache"
2026-09-24T00:30:42.9828267Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:42.9828456Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:42.9829139Z     # required to build '-native' target
2026-09-24T00:30:42.9829348Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:42.9829545Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:42.9829763Z   ccache-recipe-contol: |
2026-09-24T00:30:42.9829941Z     # disable all recipes
2026-09-24T00:30:42.9830123Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:42.9830358Z     # table with enabled recipes
2026-09-24T00:30:42.9830571Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:42.9830790Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:42.9831034Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:42.9831275Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:42.9831484Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:42.9831718Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:42.9831928Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:42.9832293Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:42.9832505Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:42.9832785Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:42.9833003Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:42.9833224Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:42.9833428Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:42.9833635Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:42.9833833Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:42.9834255Z   ci: |
2026-09-24T00:30:42.9834420Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:42.9834645Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:42.9834984Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:42.9835304Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:42.9835500Z   parallelism: |
2026-09-24T00:30:42.9835738Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:42.9836009Z     #
2026-09-24T00:30:42.9836223Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:42.9836565Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:42.9836892Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:42.9837223Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:42.9837729Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:42.9838077Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:42.9838419Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:42.9838744Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:42.9839087Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:42.9839296Z     #
2026-09-24T00:30:42.9839520Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:42.9839868Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:42.9840225Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:42.9840578Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:42.9841037Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:42.9841358Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:42.9841581Z     #
2026-09-24T00:30:42.9841815Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:42.9842152Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:42.9842436Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:42.9842643Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:42.9842840Z     do_compile[number_threads] = "8"
2026-09-24T00:30:42.9843031Z   git-dl: |
2026-09-24T00:30:42.9843244Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:42.9843557Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:42.9843881Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:42.9844141Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:42.9844337Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:42.9844573Z   git-shallow-kernels: |
2026-09-24T00:30:42.9844829Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:42.9845157Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:42.9845494Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:42.9845774Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:42.9845990Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:42.9846207Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:42.9846436Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:42.9846636Z   base: |
2026-09-24T00:30:42.9846782Z     CONF_VERSION = "2"
2026-09-24T00:30:42.9846966Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:42.9847166Z     INHERIT += "buildhistory"
2026-09-24T00:30:42.9847474Z     INHERIT += "rm_work"
2026-09-24T00:30:42.9847678Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:42.9847873Z   diskmon: |
2026-09-24T00:30:42.9848040Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:42.9848304Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:42.9848496Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:42.9848700Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:30:42.9848907Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:30:42.9849099Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:30:42.9849286Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:30:42.9849468Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:30:42.9849662Z       HALT,/tmp,10M,1K"
2026-09-24T00:30:42.9849831Z   clo-mirrors: |
2026-09-24T00:30:42.9849992Z     MIRRORS:append = " \
2026-09-24T00:30:42.9850244Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T00:30:42.9850564Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T00:30:42.9850856Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \

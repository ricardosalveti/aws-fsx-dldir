2026-09-24T15:53:54.8968485Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:53:54.8968713Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:53:54.8968988Z     # required to build '-native' target
2026-09-24T15:53:54.8969191Z     HOSTTOOLS += "ccache"
2026-09-24T15:53:54.8969436Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:53:54.8969650Z   ccache-recipe-contol: |
2026-09-24T15:53:54.8969831Z     # disable all recipes
2026-09-24T15:53:54.8970002Z     CCACHE_DISABLE = "1"
2026-09-24T15:53:54.8970212Z     # table with enabled recipes
2026-09-24T15:53:54.8970425Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:53:54.8970630Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:53:54.8970866Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:53:54.8971104Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:53:54.8971317Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:53:54.8971540Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:53:54.8971751Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:53:54.8971954Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:53:54.8972153Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:53:54.8972366Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:53:54.8972581Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:53:54.8972806Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:53:54.8973009Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:53:54.8973205Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:53:54.8973402Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:53:54.8973766Z   ci: |
2026-09-24T15:53:54.8973934Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:53:54.8974159Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:53:54.8974482Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:53:54.8974798Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:53:54.8975001Z   parallelism: |
2026-09-24T15:53:54.8975234Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:53:54.8975495Z     #
2026-09-24T15:53:54.8975711Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:53:54.8976058Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:53:54.8976382Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:53:54.8976704Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:53:54.8977046Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:53:54.8977403Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:53:54.8977933Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:53:54.8978266Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:53:54.8978554Z     # reach sstate, so re-running never helps.
2026-09-24T15:53:54.8978768Z     #
2026-09-24T15:53:54.8978990Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:53:54.8979341Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:53:54.8979690Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:53:54.8980042Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:53:54.8980504Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:53:54.8980822Z     # warm build, so neither setting costs anything there.
2026-09-24T15:53:54.8981054Z     #
2026-09-24T15:53:54.8981268Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:53:54.8981595Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:53:54.8981863Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:53:54.8982064Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:53:54.8982255Z     do_compile[number_threads] = "8"
2026-09-24T15:53:54.8982441Z   git-dl: |
2026-09-24T15:53:54.8982650Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:53:54.8982958Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:53:54.8983284Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:53:54.8983539Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:53:54.8983732Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:53:54.8983936Z   git-shallow-kernels: |
2026-09-24T15:53:54.8984192Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:53:54.8984524Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:53:54.8984860Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:53:54.8985139Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:53:54.8985359Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:53:54.8985576Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:53:54.8985804Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:53:54.8986038Z   base: |
2026-09-24T15:53:54.8986180Z     CONF_VERSION = "2"
2026-09-24T15:53:54.8986360Z     INHERIT += "buildstats-summary"
2026-09-24T15:53:54.8986562Z     INHERIT += "buildhistory"
2026-09-24T15:53:54.8986745Z     INHERIT += "rm_work"
2026-09-24T15:53:54.8986930Z     INHERIT += "image-buildinfo"
2026-09-24T15:53:54.8987111Z   diskmon: |
2026-09-24T15:53:54.8987268Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:53:54.8987507Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:53:54.8987853Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:53:54.8988053Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:53:54.8988261Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:53:54.8988454Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:53:54.8988648Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:53:54.8988832Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:53:54.8989021Z       HALT,/tmp,10M,1K"
2026-09-24T15:53:54.8989189Z   clo-mirrors: |
2026-09-24T15:53:54.8989350Z     MIRRORS:append = " \
2026-09-24T15:53:54.8989611Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T15:53:54.8989920Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:53:54.8990221Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T15:53:54.8990467Z     "
2026-09-24T15:53:54.8990612Z   cmdline: |

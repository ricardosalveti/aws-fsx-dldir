2026-09-24T15:51:34.3838228Z     # table with enabled recipes
2026-09-24T15:51:34.3838480Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:51:34.3838695Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:51:34.3838947Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:51:34.3839182Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:51:34.3839397Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:51:34.3839627Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:51:34.3839850Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:51:34.3840051Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:51:34.3840252Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:51:34.3840467Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:51:34.3840685Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:51:34.3840919Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:51:34.3841126Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:51:34.3841327Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:51:34.3841525Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:51:34.3842174Z   ci: |
2026-09-24T15:51:34.3842342Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:51:34.3842572Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:51:34.3842904Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:51:34.3843234Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:51:34.3843438Z   parallelism: |
2026-09-24T15:51:34.3843677Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:51:34.3843937Z     #
2026-09-24T15:51:34.3844164Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:51:34.3844502Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:51:34.3844831Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:51:34.3845191Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:51:34.3845543Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:51:34.3845894Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:51:34.3846234Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:51:34.3846713Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:51:34.3847040Z     # reach sstate, so re-running never helps.
2026-09-24T15:51:34.3847252Z     #
2026-09-24T15:51:34.3847484Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:51:34.3847836Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:51:34.3848227Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:51:34.3848571Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:51:34.3848907Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:51:34.3849319Z     # warm build, so neither setting costs anything there.
2026-09-24T15:51:34.3849566Z     #
2026-09-24T15:51:34.3849789Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:51:34.3850120Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:51:34.3850391Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:51:34.3850615Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:51:34.3850809Z     do_compile[number_threads] = "8"
2026-09-24T15:51:34.3851002Z   git-dl: |
2026-09-24T15:51:34.3851217Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:51:34.3851534Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:51:34.3851841Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:51:34.3852104Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:51:34.3852300Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:51:34.3852518Z   git-shallow-kernels: |
2026-09-24T15:51:34.3852769Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:51:34.3853103Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:51:34.3853440Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:51:34.3853731Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:51:34.3853946Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"

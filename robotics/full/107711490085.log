2026-09-24T15:51:34.3836505Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:51:34.3836805Z     # required to build '-native' target
2026-09-24T15:51:34.3837079Z     HOSTTOOLS += "ccache"
2026-09-24T15:51:34.3837336Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:51:34.3837587Z   ccache-recipe-contol: |
2026-09-24T15:51:34.3837804Z     # disable all recipes

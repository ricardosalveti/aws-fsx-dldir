2026-09-24T00:30:47.7580169Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:47.7580503Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:47.7580812Z     # required to build '-native' target
2026-09-24T00:30:47.7581126Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:47.7581325Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:47.7581600Z   ccache-recipe-contol: |
2026-09-24T00:30:47.7581860Z     # disable all recipes
2026-09-24T00:30:47.7582117Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:47.7582350Z     # table with enabled recipes
2026-09-24T00:30:47.7582588Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:47.7582861Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:47.7583116Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:47.7583353Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:47.7583564Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:47.7583791Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:47.7584065Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:47.7584266Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:47.7584476Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:47.7584689Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:47.7585083Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:47.7585308Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:47.7585529Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:47.7585734Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:47.7585932Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:47.7586125Z   ci: |
2026-09-24T00:30:47.7586299Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:47.7586648Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:47.7586982Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:47.7587299Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:47.7587507Z   parallelism: |
2026-09-24T00:30:47.7587743Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:47.7588005Z     #
2026-09-24T00:30:47.7588223Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:47.7588570Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:47.7588897Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:47.7589225Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:47.7589558Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:47.7589907Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:47.7590241Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:47.7590566Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:47.7590853Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:47.7591058Z     #
2026-09-24T00:30:47.7591276Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:47.7591620Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:47.7591974Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:47.7592321Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:47.7592661Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:47.7592971Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:47.7593269Z     #
2026-09-24T00:30:47.7593501Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:47.7593831Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:47.7594101Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:47.7594307Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:47.7594509Z     do_compile[number_threads] = "8"
2026-09-24T00:30:47.7594704Z   git-dl: |
2026-09-24T00:30:47.7595070Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:47.7595398Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:47.7595729Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:47.7595992Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:47.7596192Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:47.7596398Z   git-shallow-kernels: |
2026-09-24T00:30:47.7596657Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:47.7596998Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:47.7597343Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:47.7597625Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:47.7597850Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:47.7598070Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:47.7598297Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:47.7598506Z   base: |
2026-09-24T00:30:47.7598664Z     CONF_VERSION = "2"
2026-09-24T00:30:47.7598845Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:47.7599048Z     INHERIT += "buildhistory"
2026-09-24T00:30:47.7599231Z     INHERIT += "rm_work"
2026-09-24T00:30:47.7599413Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:47.7599602Z   diskmon: |
2026-09-24T00:30:47.7599754Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:47.7599940Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:47.7600141Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:47.7600427Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:30:47.7600633Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:30:47.7600823Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:30:47.7601008Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:30:47.7601208Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:30:47.7601404Z       HALT,/tmp,10M,1K"
2026-09-24T00:30:47.7601573Z   clo-mirrors: |

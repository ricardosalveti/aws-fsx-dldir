2026-09-24T15:50:19.1233090Z header:
2026-09-24T15:50:19.1233537Z   version: 14
2026-09-24T15:50:19.1233767Z local_conf_header:
2026-09-24T15:50:19.1233935Z   mirror: |
2026-09-24T15:50:19.1234280Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T15:50:19.1234600Z   ccache: |
2026-09-24T15:50:19.1234755Z     INHERIT += "ccache"
2026-09-24T15:50:19.1234924Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:50:19.1235384Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:50:19.1235602Z     # required to build '-native' target
2026-09-24T15:50:19.1235832Z     HOSTTOOLS += "ccache"
2026-09-24T15:50:19.1236052Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:50:19.1236299Z   ccache-recipe-contol: |
2026-09-24T15:50:19.1236477Z     # disable all recipes
2026-09-24T15:50:19.1236654Z     CCACHE_DISABLE = "1"
2026-09-24T15:50:19.1236833Z     # table with enabled recipes
2026-09-24T15:50:19.1237050Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:50:19.1237258Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:50:19.1237489Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:50:19.1237725Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:50:19.1237933Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:50:19.1238155Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:50:19.1238360Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:50:19.1238561Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:50:19.1238756Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:50:19.1238960Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:50:19.1239213Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:50:19.1239435Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:50:19.1239795Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:50:19.1239995Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:50:19.1240191Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:50:19.1240392Z   ci: |
2026-09-24T15:50:19.1240789Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:50:19.1241005Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:50:19.1241473Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:50:19.1241804Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:50:19.1242007Z   parallelism: |
2026-09-24T15:50:19.1242240Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:50:19.1242563Z     #
2026-09-24T15:50:19.1242780Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:50:19.1243116Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:50:19.1243453Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:50:19.1243780Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:50:19.1244121Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:50:19.1244467Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:50:19.1244801Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:50:19.1245122Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:50:19.1245400Z     # reach sstate, so re-running never helps.
2026-09-24T15:50:19.1245597Z     #
2026-09-24T15:50:19.1245825Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:50:19.1246167Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:50:19.1246509Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:50:19.1246844Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:50:19.1247186Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:50:19.1247570Z     # warm build, so neither setting costs anything there.
2026-09-24T15:50:19.1247794Z     #
2026-09-24T15:50:19.1248000Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:50:19.1248336Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:50:19.1248605Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:50:19.1248804Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:50:19.1248991Z     do_compile[number_threads] = "8"
2026-09-24T15:50:19.1249185Z   git-dl: |
2026-09-24T15:50:19.1249389Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:50:19.1249697Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:50:19.1249998Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:50:19.1250262Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:50:19.1250455Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:50:19.1250649Z   git-shallow-kernels: |
2026-09-24T15:50:19.1250893Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:50:19.1251232Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:50:19.1251692Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:50:19.1251968Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:50:19.1252175Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:50:19.1252403Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:50:19.1252630Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"

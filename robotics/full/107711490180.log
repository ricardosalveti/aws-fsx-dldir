2026-09-24T15:51:15.2869292Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T15:51:15.2869616Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:51:15.2869923Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T15:51:15.2870178Z     "
2026-09-24T15:51:15.2870332Z   cmdline: |
2026-09-24T15:51:15.2870537Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"
2026-09-24T15:51:15.2870770Z   extra: |

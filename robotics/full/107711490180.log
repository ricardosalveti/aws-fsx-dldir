2026-09-24T15:51:15.2849207Z     # table with enabled recipes
2026-09-24T15:51:15.2849482Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:51:15.2849732Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:51:15.2850012Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:51:15.2850293Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:51:15.2850539Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:51:15.2850778Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:51:15.2851149Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:51:15.2851361Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:51:15.2851571Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:51:15.2851799Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:51:15.2852021Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:51:15.2852245Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:51:15.2852453Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:51:15.2852662Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:51:15.2852866Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:51:15.2853280Z   ci: |
2026-09-24T15:51:15.2853442Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:51:15.2853665Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:51:15.2854015Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:51:15.2854335Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:51:15.2854534Z   parallelism: |
2026-09-24T15:51:15.2854776Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:51:15.2855046Z     #
2026-09-24T15:51:15.2855267Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:51:15.2855606Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:51:15.2855927Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:51:15.2856259Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:51:15.2856599Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:51:15.2856941Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:51:15.2857282Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:51:15.2857607Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:51:15.2857895Z     # reach sstate, so re-running never helps.
2026-09-24T15:51:15.2858101Z     #
2026-09-24T15:51:15.2858490Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:51:15.2858840Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:51:15.2859189Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:51:15.2859525Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:51:15.2859984Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:51:15.2860304Z     # warm build, so neither setting costs anything there.
2026-09-24T15:51:15.2860530Z     #
2026-09-24T15:51:15.2860753Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:51:15.2861086Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:51:15.2861352Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:51:15.2861558Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:51:15.2861743Z     do_compile[number_threads] = "8"
2026-09-24T15:51:15.2861938Z   git-dl: |
2026-09-24T15:51:15.2862145Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:51:15.2862458Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:51:15.2862767Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:51:15.2863033Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:51:15.2863231Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:51:15.2863438Z   git-shallow-kernels: |
2026-09-24T15:51:15.2863690Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:51:15.2864022Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:51:15.2864367Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:51:15.2864649Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:51:15.2864867Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:51:15.2865093Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:51:15.2865338Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:51:15.2865551Z   base: |
2026-09-24T15:51:15.2865701Z     CONF_VERSION = "2"
2026-09-24T15:51:15.2865869Z     INHERIT += "buildstats-summary"
2026-09-24T15:51:15.2866133Z     INHERIT += "buildhistory"
2026-09-24T15:51:15.2866317Z     INHERIT += "rm_work"
2026-09-24T15:51:15.2866507Z     INHERIT += "image-buildinfo"
2026-09-24T15:51:15.2866695Z   diskmon: |
2026-09-24T15:51:15.2866856Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:51:15.2867111Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:51:15.2867322Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:51:15.2867524Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:51:15.2867730Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:51:15.2867928Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:51:15.2868124Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:51:15.2868461Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:51:15.2868680Z       HALT,/tmp,10M,1K"
2026-09-24T15:51:15.2868853Z   clo-mirrors: |

2026-09-24T15:51:15.2823837Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:51:15.2824061Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:51:15.2847470Z     # required to build '-native' target
2026-09-24T15:51:15.2847841Z     HOSTTOOLS += "ccache"
2026-09-24T15:51:15.2848099Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:51:15.2848596Z   ccache-recipe-contol: |

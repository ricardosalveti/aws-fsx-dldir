2026-09-24T00:31:18.5375982Z header:
2026-09-24T00:31:18.5376201Z   version: 14
2026-09-24T00:31:18.5376361Z local_conf_header:
2026-09-24T00:31:18.5376534Z   mirror: |
2026-09-24T00:31:18.5376885Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:31:18.5377213Z   ccache: |
2026-09-24T00:31:18.5377368Z     INHERIT += "ccache"
2026-09-24T00:31:18.5377554Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:31:18.5377749Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:31:18.5378056Z     # required to build '-native' target
2026-09-24T00:31:18.5378298Z     HOSTTOOLS += "ccache"
2026-09-24T00:31:18.5378556Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:31:18.5378888Z   ccache-recipe-contol: |
2026-09-24T00:31:18.5379105Z     # disable all recipes
2026-09-24T00:31:18.5379299Z     CCACHE_DISABLE = "1"
2026-09-24T00:31:18.5379480Z     # table with enabled recipes
2026-09-24T00:31:18.5379681Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:31:18.5379885Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:31:18.5380135Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:31:18.5380372Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:31:18.5380583Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:31:18.5380816Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:31:18.5381036Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:31:18.5381229Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:31:18.5381431Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:31:18.5381640Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:31:18.5381857Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:31:18.5382087Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:31:18.5382298Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:31:18.5382705Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:31:18.5382906Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:31:18.5383113Z   ci: |
2026-09-24T00:31:18.5383274Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:31:18.5383723Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:31:18.5384130Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:31:18.5384453Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:31:18.5384655Z   parallelism: |
2026-09-24T00:31:18.5384904Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:31:18.5385170Z     #
2026-09-24T00:31:18.5385390Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:31:18.5385737Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:31:18.5386081Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:31:18.5386416Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:31:18.5386766Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:31:18.5387132Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:31:18.5387470Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:31:18.5387799Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:31:18.5388082Z     # reach sstate, so re-running never helps.
2026-09-24T00:31:18.5388281Z     #
2026-09-24T00:31:18.5388507Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:31:18.5388849Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:31:18.5389191Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:31:18.5389646Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:31:18.5389989Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:31:18.5390294Z     # warm build, so neither setting costs anything there.
2026-09-24T00:31:18.5390510Z     #
2026-09-24T00:31:18.5390725Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:31:18.5391044Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:31:18.5391309Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:31:18.5391511Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:31:18.5391698Z     do_compile[number_threads] = "8"
2026-09-24T00:31:18.5391892Z   git-dl: |
2026-09-24T00:31:18.5392100Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:31:18.5392408Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:31:18.5392713Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:31:18.5392976Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:31:18.5393173Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:31:18.5393376Z   git-shallow-kernels: |
2026-09-24T00:31:18.5393778Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:31:18.5394137Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:31:18.5394484Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:31:18.5394762Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"

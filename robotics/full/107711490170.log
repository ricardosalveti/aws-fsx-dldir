2026-09-24T15:50:45.5217550Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:50:45.5217795Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:50:45.5218039Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:50:45.5218262Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:50:45.5218489Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:50:45.5218708Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:50:45.5218959Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:50:45.5219167Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:50:45.5219380Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:50:45.5219597Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:50:45.5219811Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:50:45.5220013Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:50:45.5220214Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:50:45.5220410Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:50:45.5220600Z   ci: |
2026-09-24T15:50:45.5220753Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:50:45.5220983Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:50:45.5221420Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:50:45.5221915Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:50:45.5222267Z   parallelism: |
2026-09-24T15:50:45.5222514Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:50:45.5222783Z     #
2026-09-24T15:50:45.5223005Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:50:45.5223348Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:50:45.5223680Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:50:45.5224009Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:50:45.5224349Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:50:45.5224702Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:50:45.5225052Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:50:45.5225380Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:50:45.5225667Z     # reach sstate, so re-running never helps.
2026-09-24T15:50:45.5225869Z     #
2026-09-24T15:50:45.5226096Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:50:45.5226437Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:50:45.5226787Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:50:45.5227129Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:50:45.5227476Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:50:45.5227805Z     # warm build, so neither setting costs anything there.
2026-09-24T15:50:45.5228024Z     #
2026-09-24T15:50:45.5228321Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:50:45.5228674Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:50:45.5228954Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:50:45.5229162Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:50:45.5229350Z     do_compile[number_threads] = "8"
2026-09-24T15:50:45.5229550Z   git-dl: |
2026-09-24T15:50:45.5229766Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:50:45.5230084Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:50:45.5230399Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:50:45.5230668Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:50:45.5230863Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:50:45.5231066Z   git-shallow-kernels: |
2026-09-24T15:50:45.5231310Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:50:45.5231795Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:50:45.5232140Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:50:45.5232425Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:50:45.5232641Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:50:45.5232868Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:50:45.5233100Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:50:45.5233306Z   base: |
2026-09-24T15:50:45.5233452Z     CONF_VERSION = "2"
2026-09-24T15:50:45.5233631Z     INHERIT += "buildstats-summary"
2026-09-24T15:50:45.5233843Z     INHERIT += "buildhistory"
2026-09-24T15:50:45.5234029Z     INHERIT += "rm_work"
2026-09-24T15:50:45.5234215Z     INHERIT += "image-buildinfo"
2026-09-24T15:50:45.5234397Z   diskmon: |
2026-09-24T15:50:45.5234559Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:50:45.5234743Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:50:45.5234943Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:50:45.5235257Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:50:45.5235627Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:50:45.5235825Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:50:45.5236014Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:50:45.5236203Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:50:45.5236399Z       HALT,/tmp,10M,1K"
2026-09-24T15:50:45.5236584Z   clo-mirrors: |

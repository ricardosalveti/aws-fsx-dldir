2026-09-24T15:50:45.5215437Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:50:45.5215816Z     # required to build '-native' target
2026-09-24T15:50:45.5216068Z     HOSTTOOLS += "ccache"
2026-09-24T15:50:45.5216304Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:50:45.5216516Z   ccache-recipe-contol: |

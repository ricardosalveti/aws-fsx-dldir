2026-09-24T15:50:45.5237006Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T15:50:45.5237325Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:50:45.5237646Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T15:50:45.5237902Z     "
2026-09-24T15:50:45.5238046Z   cmdline: |
2026-09-24T15:50:45.5238246Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"
2026-09-24T15:50:45.5238491Z   extra: |

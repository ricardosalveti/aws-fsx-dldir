2026-09-24T01:07:29.2130851Z     # table with enabled recipes
2026-09-24T01:07:29.2131057Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T01:07:29.2131266Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T01:07:29.2131512Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T01:07:29.2131741Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T01:07:29.2131949Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T01:07:29.2132181Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"

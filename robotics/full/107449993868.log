2026-09-24T01:07:29.2133110Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T01:07:29.2133332Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T01:07:29.2133549Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T01:07:29.2133756Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T01:07:29.2133954Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T01:07:29.2134160Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T01:07:29.2134620Z   ci: |
2026-09-24T01:07:29.2134784Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T01:07:29.2135175Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T01:07:29.2135637Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T01:07:29.2135960Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T01:07:29.2136155Z   parallelism: |
2026-09-24T01:07:29.2136390Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T01:07:29.2136648Z     #
2026-09-24T01:07:29.2136876Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T01:07:29.2137216Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T01:07:29.2137542Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T01:07:29.2137862Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T01:07:29.2138211Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T01:07:29.2138550Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T01:07:29.2138883Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T01:07:29.2139215Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T01:07:29.2139496Z     # reach sstate, so re-running never helps.
2026-09-24T01:07:29.2139694Z     #
2026-09-24T01:07:29.2139910Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T01:07:29.2140257Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T01:07:29.2140603Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T01:07:29.2140939Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T01:07:29.2141409Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T01:07:29.2141734Z     # warm build, so neither setting costs anything there.
2026-09-24T01:07:29.2141960Z     #
2026-09-24T01:07:29.2142179Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T01:07:29.2142504Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T01:07:29.2142785Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T01:07:29.2142989Z     PARALLEL_MAKE = "-j 4"
2026-09-24T01:07:29.2143180Z     do_compile[number_threads] = "8"
2026-09-24T01:07:29.2143367Z   git-dl: |
2026-09-24T01:07:29.2143574Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T01:07:29.2143882Z     # update them concurrently: keep them job-local and share history
2026-09-24T01:07:29.2144214Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T01:07:29.2144471Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T01:07:29.2144669Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T01:07:29.2144867Z   git-shallow-kernels: |
2026-09-24T01:07:29.2145232Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T01:07:29.2145579Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T01:07:29.2145971Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T01:07:29.2146251Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T01:07:29.2146468Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T01:07:29.2146687Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T01:07:29.2146922Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T01:07:29.2147123Z   base: |
2026-09-24T01:07:29.2147268Z     CONF_VERSION = "2"
2026-09-24T01:07:29.2147452Z     INHERIT += "buildstats-summary"
2026-09-24T01:07:29.2147651Z     INHERIT += "buildhistory"
2026-09-24T01:07:29.2147830Z     INHERIT += "rm_work"
2026-09-24T01:07:29.2148013Z     INHERIT += "image-buildinfo"
2026-09-24T01:07:29.2148204Z   diskmon: |
2026-09-24T01:07:29.2148358Z     BB_DISKMON_DIRS ??= "\
2026-09-24T01:07:29.2148613Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T01:07:29.2148810Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T01:07:29.2149012Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T01:07:29.2149216Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T01:07:29.2149409Z       HALT,${TMPDIR},100M,1K \
2026-09-24T01:07:29.2149592Z       HALT,${DL_DIR},100M,1K \
2026-09-24T01:07:29.2149774Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T01:07:29.2149977Z       HALT,/tmp,10M,1K"

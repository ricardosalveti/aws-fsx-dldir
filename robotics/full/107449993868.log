2026-09-24T01:07:29.2129453Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T01:07:29.2129668Z     # required to build '-native' target
2026-09-24T01:07:29.2129879Z     HOSTTOOLS += "ccache"
2026-09-24T01:07:29.2130069Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T01:07:29.2130284Z   ccache-recipe-contol: |
2026-09-24T01:07:29.2130462Z     # disable all recipes

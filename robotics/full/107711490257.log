2026-09-24T15:53:01.8529491Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:53:01.8529722Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:53:01.8529979Z     # required to build '-native' target
2026-09-24T15:53:01.8530199Z     HOSTTOOLS += "ccache"
2026-09-24T15:53:01.8530382Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:53:01.8530596Z   ccache-recipe-contol: |
2026-09-24T15:53:01.8530808Z     # disable all recipes
2026-09-24T15:53:01.8530980Z     CCACHE_DISABLE = "1"
2026-09-24T15:53:01.8531183Z     # table with enabled recipes
2026-09-24T15:53:01.8531378Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:53:01.8531587Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:53:01.8531825Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:53:01.8532054Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:53:01.8532264Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:53:01.8532484Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:53:01.8532684Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:53:01.8533042Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:53:01.8533247Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:53:01.8533457Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:53:01.8533668Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:53:01.8533889Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:53:01.8534091Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:53:01.8534285Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:53:01.8534483Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:53:01.8534679Z   ci: |
2026-09-24T15:53:01.8535002Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:53:01.8535226Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:53:01.8535554Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:53:01.8535878Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:53:01.8536069Z   parallelism: |
2026-09-24T15:53:01.8536299Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:53:01.8536564Z     #
2026-09-24T15:53:01.8536788Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:53:01.8537122Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:53:01.8537445Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:53:01.8537769Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:53:01.8538118Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:53:01.8538457Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:53:01.8538789Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:53:01.8539119Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:53:01.8539412Z     # reach sstate, so re-running never helps.
2026-09-24T15:53:01.8539606Z     #
2026-09-24T15:53:01.8539824Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:53:01.8540165Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:53:01.8540520Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:53:01.8540854Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:53:01.8541292Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:53:01.8541599Z     # warm build, so neither setting costs anything there.
2026-09-24T15:53:01.8541827Z     #
2026-09-24T15:53:01.8542035Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:53:01.8542363Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:53:01.8542629Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:53:01.8542954Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:53:01.8543157Z     do_compile[number_threads] = "8"
2026-09-24T15:53:01.8543344Z   git-dl: |
2026-09-24T15:53:01.8543548Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:53:01.8543869Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:53:01.8544336Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:53:01.8544609Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:53:01.8544807Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:53:01.8545020Z   git-shallow-kernels: |
2026-09-24T15:53:01.8545264Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:53:01.8545597Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:53:01.8545969Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:53:01.8546251Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:53:01.8546463Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:53:01.8546677Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:53:01.8546903Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:53:01.8547113Z   base: |
2026-09-24T15:53:01.8547256Z     CONF_VERSION = "2"
2026-09-24T15:53:01.8547433Z     INHERIT += "buildstats-summary"
2026-09-24T15:53:01.8547633Z     INHERIT += "buildhistory"
2026-09-24T15:53:01.8547812Z     INHERIT += "rm_work"
2026-09-24T15:53:01.8547993Z     INHERIT += "image-buildinfo"
2026-09-24T15:53:01.8548173Z   diskmon: |
2026-09-24T15:53:01.8548330Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:53:01.8548589Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:53:01.8548790Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:53:01.8548985Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:53:01.8549187Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:53:01.8549376Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:53:01.8549566Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:53:01.8549746Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:53:01.8549934Z       HALT,/tmp,10M,1K"
2026-09-24T15:53:01.8550096Z   clo-mirrors: |
2026-09-24T15:53:01.8550254Z     MIRRORS:append = " \
2026-09-24T15:53:01.8550508Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T15:53:01.8550819Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:53:01.8551121Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T15:53:01.8551367Z     "
2026-09-24T15:53:01.8551513Z   cmdline: |
2026-09-24T15:53:01.8551713Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"
2026-09-24T15:53:01.8551943Z   extra: |
2026-09-24T15:53:01.8552118Z     DISTRO_FEATURES:append = " efi pam pni-names"
2026-09-24T15:53:01.8552458Z     EXTRA_IMAGE_FEATURES += "allow-empty-password empty-root-password allow-root-login"
2026-09-24T15:53:01.8552771Z     IMAGE_ROOTFS_EXTRA_SPACE = "307200"

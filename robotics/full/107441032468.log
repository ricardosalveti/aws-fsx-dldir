2026-09-24T00:30:42.8039590Z local_conf_header:
2026-09-24T00:30:42.8039766Z   mirror: |
2026-09-24T00:30:42.8040136Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:30:42.8040469Z   ccache: |
2026-09-24T00:30:42.8040641Z     INHERIT += "ccache"
2026-09-24T00:30:42.8041174Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:42.8041383Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:42.8041625Z     # required to build '-native' target
2026-09-24T00:30:42.8041847Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:42.8042046Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:42.8042259Z   ccache-recipe-contol: |
2026-09-24T00:30:42.8042444Z     # disable all recipes
2026-09-24T00:30:42.8042625Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:42.8042826Z     # table with enabled recipes
2026-09-24T00:30:42.8043032Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:42.8043264Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:42.8043509Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:42.8043753Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:42.8043971Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:42.8044201Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:42.8044411Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:42.8044615Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:42.8044816Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:42.8045046Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:42.8045299Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:42.8045533Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:42.8045741Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:42.8045941Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:42.8046138Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:42.8046331Z   ci: |
2026-09-24T00:30:42.8046496Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:42.8046722Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:42.8047296Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:42.8047616Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:42.8047837Z   parallelism: |
2026-09-24T00:30:42.8048077Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:42.8048348Z     #
2026-09-24T00:30:42.8048571Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:42.8048930Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:42.8049262Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:42.8049638Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:42.8049981Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:42.8050333Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:42.8050682Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:42.8051154Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:42.8051447Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:42.8051649Z     #
2026-09-24T00:30:42.8051878Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:42.8052227Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:42.8052578Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:42.8052913Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:42.8053254Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:42.8053569Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:42.8053927Z     #
2026-09-24T00:30:42.8054144Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:42.8054486Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:42.8054755Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:42.8054963Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:42.8055154Z     do_compile[number_threads] = "8"
2026-09-24T00:30:42.8055350Z   git-dl: |
2026-09-24T00:30:42.8055564Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:42.8055882Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:42.8056195Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:42.8056467Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:42.8056661Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:42.8056861Z   git-shallow-kernels: |
2026-09-24T00:30:42.8057103Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:42.8057449Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:42.8057792Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:42.8058071Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:42.8058291Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:42.8058521Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:42.8058759Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:42.8058966Z   base: |
2026-09-24T00:30:42.8059104Z     CONF_VERSION = "2"
2026-09-24T00:30:42.8059274Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:42.8059484Z     INHERIT += "buildhistory"
2026-09-24T00:30:42.8059676Z     INHERIT += "rm_work"
2026-09-24T00:30:42.8059865Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:42.8060055Z   diskmon: |
2026-09-24T00:30:42.8060218Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:42.8060399Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:42.8060599Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:42.8060995Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:30:42.8061219Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:30:42.8061417Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:30:42.8061614Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:30:42.8061798Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:30:42.8061995Z       HALT,/tmp,10M,1K"
2026-09-24T00:30:42.8062181Z   clo-mirrors: |
2026-09-24T00:30:42.8062351Z     MIRRORS:append = " \
2026-09-24T00:30:42.8062608Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T00:30:42.8062920Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T00:30:42.8063241Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T00:30:42.8063496Z     "
2026-09-24T00:30:42.8063644Z   cmdline: |
2026-09-24T00:30:42.8063838Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"

2026-09-24T00:30:49.9883407Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:49.9883668Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:49.9883934Z     # required to build '-native' target
2026-09-24T00:30:49.9884187Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:49.9884387Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:49.9884596Z   ccache-recipe-contol: |

2026-09-24T00:30:49.9885171Z     # table with enabled recipes
2026-09-24T00:30:49.9885377Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:49.9885575Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:49.9885810Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:49.9886100Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:49.9886322Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:49.9886544Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:49.9886750Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:49.9886953Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:49.9887149Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:49.9887357Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:49.9887566Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:49.9887788Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:49.9887990Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:49.9888188Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:49.9888381Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:49.9888732Z   ci: |
2026-09-24T00:30:49.9889121Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:49.9889343Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:49.9889658Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:49.9889968Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:49.9890169Z   parallelism: |
2026-09-24T00:30:49.9890400Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:49.9890710Z     #
2026-09-24T00:30:49.9890929Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:49.9891256Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:49.9891575Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:49.9891897Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:49.9892235Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:49.9892576Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:49.9892903Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:49.9893222Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:49.9893496Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:49.9893694Z     #
2026-09-24T00:30:49.9893909Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:49.9894259Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:49.9894598Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:49.9894930Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:49.9895262Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:49.9895656Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:49.9895885Z     #
2026-09-24T00:30:49.9896097Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:49.9896448Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:49.9896727Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:49.9896927Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:49.9897112Z     do_compile[number_threads] = "8"
2026-09-24T00:30:49.9897295Z   git-dl: |
2026-09-24T00:30:49.9897510Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:49.9897817Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:49.9898121Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:49.9898377Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:49.9898726Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:49.9898940Z   git-shallow-kernels: |
2026-09-24T00:30:49.9899184Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:49.9899504Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:49.9899847Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:49.9900121Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:49.9900327Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:49.9900534Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:49.9900765Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:49.9900966Z   base: |
2026-09-24T00:30:49.9901108Z     CONF_VERSION = "2"
2026-09-24T00:30:49.9901288Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:49.9901483Z     INHERIT += "buildhistory"
2026-09-24T00:30:49.9901666Z     INHERIT += "rm_work"
2026-09-24T00:30:49.9901843Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:49.9902021Z   diskmon: |
2026-09-24T00:30:49.9902180Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:49.9902440Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:49.9902634Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:49.9902824Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:30:49.9903025Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:30:49.9903218Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:30:49.9903402Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:30:49.9903587Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:30:49.9903777Z       HALT,/tmp,10M,1K"
2026-09-24T00:30:49.9903940Z   clo-mirrors: |
2026-09-24T00:30:49.9904111Z     MIRRORS:append = " \
2026-09-24T00:30:49.9904356Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T00:30:49.9904662Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T00:30:49.9904958Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T00:30:49.9905205Z     "
2026-09-24T00:30:49.9905338Z   cmdline: |
2026-09-24T00:30:49.9905532Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"
2026-09-24T00:30:49.9905761Z   extra: |
2026-09-24T00:30:49.9905947Z     DISTRO_FEATURES:append = " efi pam pni-names"

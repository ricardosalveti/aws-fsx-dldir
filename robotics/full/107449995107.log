2026-09-24T00:30:48.4549282Z local_conf_header:
2026-09-24T00:30:48.4549543Z   mirror: |
2026-09-24T00:30:48.4549913Z     SSTATE_MIRRORS = "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
2026-09-24T00:30:48.4550269Z   ccache: |
2026-09-24T00:30:48.4550426Z     INHERIT += "ccache"
2026-09-24T00:30:48.4550610Z     CCACHE_MAXSIZE = "200G"
2026-09-24T00:30:48.4550812Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T00:30:48.4551047Z     # required to build '-native' target
2026-09-24T00:30:48.4551264Z     HOSTTOOLS += "ccache"
2026-09-24T00:30:48.4551459Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T00:30:48.4551693Z   ccache-recipe-contol: |
2026-09-24T00:30:48.4551935Z     # disable all recipes
2026-09-24T00:30:48.4552137Z     CCACHE_DISABLE = "1"
2026-09-24T00:30:48.4552351Z     # table with enabled recipes
2026-09-24T00:30:48.4552599Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T00:30:48.4552880Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T00:30:48.4553126Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T00:30:48.4553390Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T00:30:48.4553606Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T00:30:48.4553835Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T00:30:48.4554048Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T00:30:48.4554258Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T00:30:48.4554460Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T00:30:48.4554715Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T00:30:48.4554957Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T00:30:48.4555210Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T00:30:48.4555522Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T00:30:48.4555742Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T00:30:48.4556090Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T00:30:48.4556297Z   ci: |
2026-09-24T00:30:48.4556454Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T00:30:48.4557174Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T00:30:48.4557511Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T00:30:48.4557846Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T00:30:48.4558049Z   parallelism: |
2026-09-24T00:30:48.4558288Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T00:30:48.4558544Z     #
2026-09-24T00:30:48.4558768Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T00:30:48.4559108Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T00:30:48.4559640Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T00:30:48.4559978Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T00:30:48.4560337Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T00:30:48.4560693Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T00:30:48.4561054Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T00:30:48.4561388Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T00:30:48.4561688Z     # reach sstate, so re-running never helps.
2026-09-24T00:30:48.4561892Z     #
2026-09-24T00:30:48.4562120Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T00:30:48.4562468Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T00:30:48.4562826Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T00:30:48.4563163Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T00:30:48.4563502Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T00:30:48.4563919Z     # warm build, so neither setting costs anything there.
2026-09-24T00:30:48.4564149Z     #
2026-09-24T00:30:48.4564400Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T00:30:48.4564732Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T00:30:48.4565003Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T00:30:48.4565215Z     PARALLEL_MAKE = "-j 4"
2026-09-24T00:30:48.4565409Z     do_compile[number_threads] = "8"
2026-09-24T00:30:48.4565601Z   git-dl: |
2026-09-24T00:30:48.4565922Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T00:30:48.4566270Z     # update them concurrently: keep them job-local and share history
2026-09-24T00:30:48.4566589Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T00:30:48.4566847Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T00:30:48.4567041Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T00:30:48.4567255Z   git-shallow-kernels: |
2026-09-24T00:30:48.4567517Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T00:30:48.4567852Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T00:30:48.4568193Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T00:30:48.4568478Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T00:30:48.4568692Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T00:30:48.4568910Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T00:30:48.4569138Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T00:30:48.4569357Z   base: |
2026-09-24T00:30:48.4569499Z     CONF_VERSION = "2"
2026-09-24T00:30:48.4569680Z     INHERIT += "buildstats-summary"
2026-09-24T00:30:48.4569878Z     INHERIT += "buildhistory"
2026-09-24T00:30:48.4570071Z     INHERIT += "rm_work"
2026-09-24T00:30:48.4570251Z     INHERIT += "image-buildinfo"
2026-09-24T00:30:48.4570434Z   diskmon: |
2026-09-24T00:30:48.4570590Z     BB_DISKMON_DIRS ??= "\
2026-09-24T00:30:48.4570782Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T00:30:48.4571070Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T00:30:48.4571276Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T00:30:48.4571477Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T00:30:48.4571674Z       HALT,${TMPDIR},100M,1K \
2026-09-24T00:30:48.4571871Z       HALT,${DL_DIR},100M,1K \
2026-09-24T00:30:48.4572056Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T00:30:48.4572255Z       HALT,/tmp,10M,1K"
2026-09-24T00:30:48.4572431Z   clo-mirrors: |
2026-09-24T00:30:48.4572609Z     MIRRORS:append = " \
2026-09-24T00:30:48.4572859Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T00:30:48.4573169Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T00:30:48.4573462Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T00:30:48.4573705Z     "
2026-09-24T00:30:48.4573847Z   cmdline: |
2026-09-24T00:30:48.4574050Z     KERNEL_CMDLINE_EXTRA:append = " qcom_scm.download_mode=1"

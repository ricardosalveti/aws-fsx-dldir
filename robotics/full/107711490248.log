2026-09-24T15:51:11.2633168Z     CCACHE_MAXSIZE = "200G"
2026-09-24T15:51:11.2633447Z     CCACHE_TOP_DIR = "${SSTATE_DIR}/ccache"
2026-09-24T15:51:11.2633700Z     # required to build '-native' target
2026-09-24T15:51:11.2633913Z     HOSTTOOLS += "ccache"
2026-09-24T15:51:11.2634119Z     ASSUME_PROVIDED += "ccache-native"
2026-09-24T15:51:11.2634345Z   ccache-recipe-contol: |
2026-09-24T15:51:11.2634562Z     # disable all recipes
2026-09-24T15:51:11.2634835Z     CCACHE_DISABLE = "1"
2026-09-24T15:51:11.2635031Z     # table with enabled recipes
2026-09-24T15:51:11.2635236Z     CCACHE_DISABLE:pn-clang = "0"
2026-09-24T15:51:11.2635448Z     CCACHE_DISABLE:pn-clang-native = "0"
2026-09-24T15:51:11.2635684Z     CCACHE_DISABLE:pn-chromium-ozone-wayland = "0"
2026-09-24T15:51:11.2635926Z     CCACHE_DISABLE:pn-gcc = "0"
2026-09-24T15:51:11.2636133Z     CCACHE_DISABLE:pn-gcc-cross-aarch64 = "0"
2026-09-24T15:51:11.2636356Z     CCACHE_DISABLE:pn-gcc-cross-arm = "0"
2026-09-24T15:51:11.2636714Z     CCACHE_DISABLE:pn-glibc = "0"
2026-09-24T15:51:11.2636920Z     CCACHE_DISABLE:pn-llvm = "0"
2026-09-24T15:51:11.2637121Z     CCACHE_DISABLE:pn-llvm-native = "0"
2026-09-24T15:51:11.2637331Z     CCACHE_DISABLE:pn-linux-qcom = "0"
2026-09-24T15:51:11.2637547Z     CCACHE_DISABLE:pn-linux-qcom-next = "0"
2026-09-24T15:51:11.2637776Z     CCACHE_DISABLE:pn-linux-yocto = "0"
2026-09-24T15:51:11.2637981Z     CCACHE_DISABLE:pn-opencv = "0"
2026-09-24T15:51:11.2638175Z     CCACHE_DISABLE:pn-rust = "0"
2026-09-24T15:51:11.2638364Z     CCACHE_DISABLE:pn-rust-native = "0"
2026-09-24T15:51:11.2638544Z   ci: |
2026-09-24T15:51:11.2638705Z     BB_SIGNATURE_HANDLER = "OEBasicHash"
2026-09-24T15:51:11.2639068Z     FIRMWARE_COMPRESSION:qcom-armv8a = "zst"
2026-09-24T15:51:11.2639401Z     # Workaround needed due https://bugzilla.yoctoproject.org/show_bug.cgi?id=16010
2026-09-24T15:51:11.2639718Z     PACKAGE_CLASSES = "package_rpm"
2026-09-24T15:51:11.2639921Z   parallelism: |
2026-09-24T15:51:11.2640157Z     # Size the builds for the runners' memory, not just for their core count.
2026-09-24T15:51:11.2640426Z     #
2026-09-24T15:51:11.2640643Z     # The runners have 16 vCPUs and 64 GB of RAM, so bitbake defaults to 16
2026-09-24T15:51:11.2641001Z     # concurrent tasks each running make with -j 16. That is fine while the
2026-09-24T15:51:11.2641336Z     # sstate cache is warm, but the cache goes cold every month and every
2026-09-24T15:51:11.2641672Z     # base.lock update moves the toolchain forward, and then the tail of an
2026-09-24T15:51:11.2642021Z     # image build has clang, clang-native, gcc, rust, opencv, onnxruntime and
2026-09-24T15:51:11.2642381Z     # the kernel compiling at the same time. Up to 256 compiler processes do
2026-09-24T15:51:11.2642720Z     # not fit in memory: the build is killed and the job fails with exit code
2026-09-24T15:51:11.2643064Z     # 137, and because the same recipes are killed on every attempt they never
2026-09-24T15:51:11.2643365Z     # reach sstate, so re-running never helps.
2026-09-24T15:51:11.2643566Z     #
2026-09-24T15:51:11.2643789Z     # Leave the number of tasks alone, as warm builds are dominated by setscene
2026-09-24T15:51:11.2644137Z     # and packaging tasks and lowering it would slow every build down, and cap
2026-09-24T15:51:11.2644495Z     # the compilation instead: at most 8 recipes compiling at once with 4 make
2026-09-24T15:51:11.2644843Z     # jobs each, which keeps the 16 cores busy while bounding the build to 32
2026-09-24T15:51:11.2645186Z     # compiler processes (2 GB each). do_compile is restored from sstate on a
2026-09-24T15:51:11.2645561Z     # warm build, so neither setting costs anything there.
2026-09-24T15:51:11.2645806Z     #
2026-09-24T15:51:11.2646018Z     # PARALLEL_MAKE is in BB_BASEHASH_IGNORE_VARS and number_threads is in
2026-09-24T15:51:11.2646355Z     # BB_SIGNATURE_EXCLUDE_FLAGS, so none of this changes task signatures.
2026-09-24T15:51:11.2646770Z     BB_PRESSURE_MAX_MEMORY = "15000"
2026-09-24T15:51:11.2646984Z     PARALLEL_MAKE = "-j 4"
2026-09-24T15:51:11.2647175Z     do_compile[number_threads] = "8"
2026-09-24T15:51:11.2647367Z   git-dl: |
2026-09-24T15:51:11.2647579Z     # Shared git clone dirs get corrupted when jobs on different hosts
2026-09-24T15:51:11.2647899Z     # update them concurrently: keep them job-local and share history
2026-09-24T15:51:11.2648222Z     # through the atomically written git2_*.tar.gz tarballs in DL_DIR.
2026-09-24T15:51:11.2648479Z     GITDIR = "${TMPDIR}/git2"
2026-09-24T15:51:11.2648673Z     BB_GENERATE_MIRROR_TARBALLS = "1"
2026-09-24T15:51:11.2648875Z   git-shallow-kernels: |
2026-09-24T15:51:11.2649135Z     # Every job rebuilding a qcom kernel restores the same multi-gigabyte
2026-09-24T15:51:11.2649474Z     # repository under one DL_DIR lock; nothing needs its history, so fetch
2026-09-24T15:51:11.2649815Z     # it shallow. linux-yocto stays full, kern-tools needs its meta branches.
2026-09-24T15:51:11.2650092Z     BB_GIT_SHALLOW:pn-linux-qcom = "1"
2026-09-24T15:51:11.2650312Z     BB_GIT_SHALLOW:pn-linux-qcom-rt = "1"
2026-09-24T15:51:11.2650524Z     BB_GIT_SHALLOW:pn-linux-qcom-next = "1"
2026-09-24T15:51:11.2650756Z     BB_GIT_SHALLOW:pn-linux-qcom-next-rt = "1"
2026-09-24T15:51:11.2650962Z   base: |
2026-09-24T15:51:11.2651117Z     CONF_VERSION = "2"
2026-09-24T15:51:11.2651300Z     INHERIT += "buildstats-summary"
2026-09-24T15:51:11.2651501Z     INHERIT += "buildhistory"
2026-09-24T15:51:11.2651682Z     INHERIT += "rm_work"
2026-09-24T15:51:11.2651872Z     INHERIT += "image-buildinfo"
2026-09-24T15:51:11.2652057Z   diskmon: |
2026-09-24T15:51:11.2652213Z     BB_DISKMON_DIRS ??= "\
2026-09-24T15:51:11.2652407Z       STOPTASKS,${TMPDIR},1G,100K \
2026-09-24T15:51:11.2652676Z       STOPTASKS,${DL_DIR},1G,100K \
2026-09-24T15:51:11.2652868Z       STOPTASKS,${SSTATE_DIR},1G,100K \
2026-09-24T15:51:11.2653066Z       STOPTASKS,/tmp,100M,100K \
2026-09-24T15:51:11.2653255Z       HALT,${TMPDIR},100M,1K \
2026-09-24T15:51:11.2653434Z       HALT,${DL_DIR},100M,1K \
2026-09-24T15:51:11.2653632Z       HALT,${SSTATE_DIR},100M,1K \
2026-09-24T15:51:11.2653821Z       HALT,/tmp,10M,1K"
2026-09-24T15:51:11.2653988Z   clo-mirrors: |
2026-09-24T15:51:11.2654149Z     MIRRORS:append = " \
2026-09-24T15:51:11.2654408Z     git://github.com git://git.codelinaro.org/clo/yocto-mirrors/github/ \
2026-09-24T15:51:11.2654732Z     git://.*/ git://git.codelinaro.org/clo/yocto-mirrors/ \
2026-09-24T15:51:11.2655040Z     https://.*/.*/ https://artifacts.codelinaro.org/codelinaro-le/ \
2026-09-24T15:51:11.2655294Z     "
